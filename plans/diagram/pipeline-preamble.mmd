%% PREAMBLE PIPELINE. Split from pipeline.mmd. Starts at the task number.
%% Ends with an active task and an initialized worktree, or with an exit.
%% Rules that apply everywhere, not steps:
%%   1. Every git interaction goes through a script. Never prose.
%%   2. Every read and write of tasks.json is atomic.
%%   3. A script that fails operationally, as opposed to returning a verdict,
%%      exits the run as run-failed. No step is retried after it has mutated
%%      anything. How far the exit workflow can run depends on where the failure
%%      happened, and there are three cases in this phase:
%%        before the task is active - report and stop; there is no run to write to
%%        active, no worktree      - exit workflow runs; modified files records []
%%        active, with worktree    - exit workflow runs in full
%%   4. A mutating box whose result is lost is never blindly retried and never
%%      assumed failed. Each one has a read-only reconciliation check that reads
%%      the world and decides whether it already happened. A safe idempotent
%%      rerun happens only after reconciliation proves it did not complete. Only
%%      an ambiguous loss is run-failed.
%%   5. A task stays unavailable to another run from "mark the task active" until its
%%      archive lands. "is the task active?" and "mark the task active" are drawn as two
%%      boxes but are one atomic read-modify-write of tasks.json under rule 2: nothing can
%%      make the task active between the two.
%% Diamond definitions where the name alone is not enough:
%%   is the worktree safe to use?      - structural: it opens, it is on the task's
%%                                       branch, its submodules are intact
%%   is the previous run's work resumable?
%%                                     - did the previous implementor record where
%%                                       in the plan it stopped?
%% Exit types this pipeline can produce:
%%   invalid-number     - not in tasks.json
%%   already-active     - a previous run left the task active
%%   blocked            - an open blocker remains
%%   run-failed         - a script failed operationally
%% run-failed is deliberately not drawn as an edge. It can leave ANY green box,
%% so drawing it would add one edge per box and hide the flow. Rule 3 is its
%% specification: a non-zero exit from any script goes straight to the exit
%% workflow with exit type run-failed and the script's stderr as the note.
%% Every exit here goes to the exit workflow, which picks its own tail.
%% invalid-number, blocked and already-active are the only exits that write
%% nothing to tasks.json: all three happen before "mark the task active", so
%% there is no run record to write to, and already-active must not touch a run
%% that belongs to another invocation. The exit workflow gives those three its
%% report-only tail; run-failed gets the full tail. That choice is drawn there,
%% not here.
%% The active task and initialized worktree this pipeline emits are the input to
%% the planning pipeline.

  TASK_NUMBER_INPUT["Input: { task number }"] --> IS_TASK_NUMBER_VALID
  IS_TASK_NUMBER_VALID{"is task number valid?"} --> IS_TASK_NUMBER_VALID_YES["YES"]
  IS_TASK_NUMBER_VALID --> IS_TASK_NUMBER_VALID_NO["NO"]
  IS_TASK_NUMBER_VALID_NO -- "exit type: invalid-number<br/>exit note: task number is not in tasks.json" --> EXIT_WORKFLOW
  IS_TASK_NUMBER_VALID_YES --> IS_TASK_BLOCKED{"is task blocked?"}
  IS_TASK_BLOCKED --> IS_TASK_BLOCKED_YES["YES"]
  IS_TASK_BLOCKED --> IS_TASK_BLOCKED_NO["NO"]
  IS_TASK_BLOCKED_YES -- "exit type: blocked<br/>exit note: an open blocker remains" --> EXIT_WORKFLOW
  IS_TASK_BLOCKED_NO --> IS_TASK_ACTIVE{"is the task active?"}
  IS_TASK_ACTIVE --> IS_TASK_ACTIVE_YES["YES"]
  IS_TASK_ACTIVE --> IS_TASK_ACTIVE_NO["NO"]
  IS_TASK_ACTIVE_YES -- "exit type: already-active<br/>exit note: a previous run<br/>left the task active" --> EXIT_WORKFLOW
  IS_TASK_ACTIVE_NO --> MARK_TASK_ACTIVE["Try: mark the task active in tasks.json"]
  MARK_TASK_ACTIVE --> DOES_WORKTREE_EXIST{"does a worktree exist?"}
  DOES_WORKTREE_EXIST --> DOES_WORKTREE_EXIST_YES["YES"]
  DOES_WORKTREE_EXIST --> DOES_WORKTREE_EXIST_NO["NO"]
  DOES_WORKTREE_EXIST_NO --> CREATE_WORKTREE["create a worktree"]
  CREATE_WORKTREE --> AUTO_GENERATE_DOCS["auto generate docs"]
  AUTO_GENERATE_DOCS --> INIT_SUBMODULES_RECURSIVELY
  DOES_WORKTREE_EXIST_YES --> IS_WORKTREE_SAFE_TO_USE{"is the worktree safe to use?"}
  IS_WORKTREE_SAFE_TO_USE --> IS_WORKTREE_SAFE_TO_USE_YES["YES"]
  IS_WORKTREE_SAFE_TO_USE --> IS_WORKTREE_SAFE_TO_USE_NO["NO"]
  IS_WORKTREE_SAFE_TO_USE_NO --> IS_PREVIOUS_RUN_RESUMABLE{"is the previous run's work resumable?"}
  IS_PREVIOUS_RUN_RESUMABLE --> IS_PREVIOUS_RUN_RESUMABLE_YES["YES"]
  IS_PREVIOUS_RUN_RESUMABLE --> IS_PREVIOUS_RUN_RESUMABLE_NO["NO"]
  IS_PREVIOUS_RUN_RESUMABLE_NO --> RESET_WORKTREE["reset the worktree"]
  RESET_WORKTREE --> AUTO_GENERATE_DOCS
  IS_PREVIOUS_RUN_RESUMABLE_YES --> UPDATE_AUTO_GENERATED_DOCS
  IS_WORKTREE_SAFE_TO_USE_YES --> UPDATE_AUTO_GENERATED_DOCS["update auto generated docs"]
  UPDATE_AUTO_GENERATED_DOCS --> INIT_SUBMODULES_RECURSIVELY["init submodules recursively"]
  INIT_SUBMODULES_RECURSIVELY --> ACTIVE_TASK_WORKTREE_OUTPUT["Output"]
  ACTIVE_TASK_WORKTREE_OUTPUT --> ACTIVE_TASK_WORKTREE_RECEIPT["Receipt: { active task, initialized worktree }"]
  ACTIVE_TASK_WORKTREE_RECEIPT --> IS_ACTIVE_TASK_RECEIPT_VALID{"is the active task receipt structure valid?"}
  IS_ACTIVE_TASK_RECEIPT_VALID --> IS_ACTIVE_TASK_RECEIPT_VALID_YES["YES"]
  IS_ACTIVE_TASK_RECEIPT_VALID --> IS_ACTIVE_TASK_RECEIPT_VALID_NO["NO"]
  IS_ACTIVE_TASK_RECEIPT_VALID_YES --> ACTIVE_TASK_WORKTREE_OUTPUT_TRUSTED["Output"]
  ACTIVE_TASK_WORKTREE_OUTPUT_TRUSTED --> ACTIVE_TASK_WORKTREE_RECEIPT_TRUSTED["Receipt: { active task, initialized worktree }"]
  IS_ACTIVE_TASK_RECEIPT_VALID_NO -- "exit type: run-failed<br/>exit note: the active task<br/>receipt is malformed" --> VALIDATOR_FAILURE_OUTPUT

  VALIDATOR_FAILURE_OUTPUT["Output"] --> VALIDATOR_FAILURE_RECEIPT["Receipt: { exitType, exitNote }"]
  VALIDATOR_FAILURE_RECEIPT --> EXIT_WORKFLOW

  EXIT_WORKFLOW["exit workflow"] --> EXIT_OUTPUT["Output"]
  EXIT_OUTPUT --> EXIT_RECEIPT["Receipt: { exitType, exitNote }"]

  %% pass/nopass: green is the branch that keeps heading for the receipt,
  %% red is the branch that ends in the exit workflow.
  classDef script fill:#2f7d46,stroke:#1e5c31,color:#ffffff
  classDef agent fill:#e07b39,stroke:#a8541f,color:#1a1a1a
  classDef decision fill:#e0b400,stroke:#a88600,color:#1a1a1a
  classDef receipt fill:#ffffff,stroke:#333333,color:#000000
  classDef output fill:#3b6ea5,stroke:#254a70,color:#ffffff
  classDef fail fill:red,stroke:#254a70,color:#ffffff
  classDef verdict fill:#4a4a4a,stroke:#8a8a8a,color:#ffffff
  classDef pass fill:#2f7d46,stroke:#1e5c31,color:#ffffff
  classDef nopass fill:#a52a1e,stroke:#6d1a12,color:#ffffff
  class IS_TASK_NUMBER_VALID,IS_TASK_ACTIVE,IS_TASK_BLOCKED,DOES_WORKTREE_EXIST,IS_WORKTREE_SAFE_TO_USE,IS_PREVIOUS_RUN_RESUMABLE,IS_ACTIVE_TASK_RECEIPT_VALID decision
  class MARK_TASK_ACTIVE,CREATE_WORKTREE,AUTO_GENERATE_DOCS,RESET_WORKTREE,UPDATE_AUTO_GENERATED_DOCS,INIT_SUBMODULES_RECURSIVELY script
  class IS_TASK_NUMBER_VALID_YES,IS_TASK_ACTIVE_NO,IS_TASK_BLOCKED_NO,DOES_WORKTREE_EXIST_YES,DOES_WORKTREE_EXIST_NO,IS_WORKTREE_SAFE_TO_USE_YES,IS_WORKTREE_SAFE_TO_USE_NO,IS_PREVIOUS_RUN_RESUMABLE_YES,IS_PREVIOUS_RUN_RESUMABLE_NO,IS_ACTIVE_TASK_RECEIPT_VALID_YES pass
  class IS_TASK_NUMBER_VALID_NO,IS_TASK_ACTIVE_YES,IS_TASK_BLOCKED_YES,IS_ACTIVE_TASK_RECEIPT_VALID_NO nopass
  class EXIT_WORKFLOW fail
  class TASK_NUMBER_INPUT,ACTIVE_TASK_WORKTREE_OUTPUT_TRUSTED,EXIT_OUTPUT,ACTIVE_TASK_WORKTREE_OUTPUT,VALIDATOR_FAILURE_OUTPUT output
  class ACTIVE_TASK_WORKTREE_RECEIPT,EXIT_RECEIPT,ACTIVE_TASK_WORKTREE_RECEIPT_TRUSTED,VALIDATOR_FAILURE_RECEIPT receipt
