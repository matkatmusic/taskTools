flowchart TB
%% The pipeline as scripts/tackle-tasks/monolith-pipeline.ts runs it: 18 blocks.
%% ---
%% Each small box is one block. Each large box is one system: the diagrams its blocks absorbed.
%% ---
%% An orange box returns a prompt. runStep() stops there and agent() answers it. Every other box continues.
%% ---
%% An edge out of an orange box is the agent's answer coming back into the run.

  subgraph preamble ["preamble status check: pipeline-preambleStatusCheck.mmd + pipeline-worktreeCheck.mmd"]
    PREAMBLE_STATUS_CHECK["task status<br/>worktree status<br/>init submodules recursively"]
  end

  subgraph docs ["document generation: pipeline-documentGeneration.mmd"]
    DOCUMENT_GENERATION["what is the docs mode?<br/>write the task brief"]
  end

  subgraph plan ["plan: pipeline-plan.mmd"]
    PLAN_THE_TASK["plan the task"]
    WHAT_DID_THE_PLANNER_RETURN["what did the planner return?<br/>2 clarify rounds done?<br/>write the clarify request"]
  end

  subgraph reviewPlan ["review plan: pipeline-reviewPlan.mmd"]
    CODEX_REVIEWS_PLAN["codex reviews the plan"]
    WHAT_IS_REVIEW_VERDICT["what is the review verdict?<br/>update tasks.json entry<br/>2 codex reviews done?"]
  end

  subgraph implement ["implement + task tests: pipeline-implement.mmd + pipeline-taskTests.mmd"]
    IMPLEMENT_TASK["implement task"]
    COMMIT_IMPLEMENTATION_IF_NEEDED["commit if needed<br/>are the task tests skipped?<br/>run task tests<br/>do the task tests pass?<br/>2 fixes done?<br/>amend entry with the failing tests"]
  end

  subgraph reviewTests ["review tests: pipeline-reviewTests.mmd"]
    CODEX_REVIEWS_TESTS["codex reviews the tests"]
    ARE_TESTS_FLAGGED["are the tests flagged?<br/>2 codex test reviews done?<br/>amend entry with codex's notes"]
  end

  subgraph rebasePreamble ["rebase preamble: pipeline-rebasePreamble.mmd"]
    LOCK_SOURCE_REPO["lock the source repo, wait up to 15 minutes"]
  end

  subgraph rebase ["rebase: pipeline-rebase.mmd"]
    REBASE_ONTO_TARGET_BRANCH["rebase onto the target branch<br/>did the rebase report conflicts?<br/>2 conflict fixes done?"]
    FIX_CONFLICTS["fix conflicts"]
    COMMIT_MERGE_CONFLICT_FIX_IF_NEEDED["commit if needed<br/>continue the rebase<br/>is the rebase finished?"]
  end

  subgraph suite ["full suite + merge + merge succeeded exit: pipeline-suite.mmd + pipeline-merge.mmd + pipeline-mergeSucceededExit.mmd"]
    RUN_FULL_SUITE["commit the suite fix if needed<br/>run the full suite, do all tests pass?<br/>2 suite fixes done?<br/>did every change stay inside the fence?<br/>merge worktrees, read the publication state<br/>record hashes and files, clean up, archive, report"]
    FIX_THE_CODEBASE_FOR_SUITE["fix the codebase so<br/>the full suite passes"]
  end

  subgraph failures ["failures exit: pipeline-failuresExit.mmd"]
    FAILURES_EXIT["did any work land? write the outcome<br/>mark inactive, release the lease and the lock<br/>report the exit type and note"]
  end

  subgraph reportOnly ["report only exit: pipeline-reportOnlyExit.mmd"]
    REPORT_ONLY_EXIT["report the exit type and note"]
  end

  STOP["stop"]

  PREAMBLE_STATUS_CHECK -- "invalid-number<br/>blocked<br/>already-active" --> REPORT_ONLY_EXIT
  PREAMBLE_STATUS_CHECK -- "not-resumable<br/>fence-violation" --> FAILURES_EXIT
  PREAMBLE_STATUS_CHECK -- "docs mode: AUTOGEN or UPDATE" --> DOCUMENT_GENERATION
  DOCUMENT_GENERATION --> PLAN_THE_TASK
  PLAN_THE_TASK -- "agent answers PLAN or CLARIFY" --> WHAT_DID_THE_PLANNER_RETURN
  WHAT_DID_THE_PLANNER_RETURN -- "PLAN" --> CODEX_REVIEWS_PLAN
  WHAT_DID_THE_PLANNER_RETURN -- "CLARIFY<br/>docs mode: UPDATE" --> DOCUMENT_GENERATION
  WHAT_DID_THE_PLANNER_RETURN -- "clarify-stuck" --> FAILURES_EXIT
  CODEX_REVIEWS_PLAN -- "agent runs codex<br/>returns its JSON" --> WHAT_IS_REVIEW_VERDICT
  WHAT_IS_REVIEW_VERDICT -- "ACCEPT<br/>AMEND_THEN_ACCEPT" --> IMPLEMENT_TASK
  WHAT_IS_REVIEW_VERDICT -- "AMEND or SCRAP<br/>replan with codex's notes" --> PLAN_THE_TASK
  WHAT_IS_REVIEW_VERDICT -- "run-failed<br/>plan-scrapped" --> FAILURES_EXIT
  IMPLEMENT_TASK -- "agent implements" --> COMMIT_IMPLEMENTATION_IF_NEEDED
  COMMIT_IMPLEMENTATION_IF_NEEDED -- "tests pass" --> CODEX_REVIEWS_TESTS
  COMMIT_IMPLEMENTATION_IF_NEEDED -- "hasTests: false" --> LOCK_SOURCE_REPO
  COMMIT_IMPLEMENTATION_IF_NEEDED -- "tests fail<br/>reimplement against the amended entry" --> IMPLEMENT_TASK
  COMMIT_IMPLEMENTATION_IF_NEEDED -- "tests-red" --> FAILURES_EXIT
  CODEX_REVIEWS_TESTS -- "agent runs the reviewer<br/>returns {flagged, notes}" --> ARE_TESTS_FLAGGED
  ARE_TESTS_FLAGGED -- "flagged<br/>reimplement against the amended entry" --> IMPLEMENT_TASK
  ARE_TESTS_FLAGGED -- "tests-flagged" --> FAILURES_EXIT
  ARE_TESTS_FLAGGED -- "not flagged" --> LOCK_SOURCE_REPO
  LOCK_SOURCE_REPO -- "lock acquired" --> REBASE_ONTO_TARGET_BRANCH
  LOCK_SOURCE_REPO -- "run-failed" --> FAILURES_EXIT
  REBASE_ONTO_TARGET_BRANCH -- "no conflicts" --> RUN_FULL_SUITE
  REBASE_ONTO_TARGET_BRANCH -- "conflicts" --> FIX_CONFLICTS
  REBASE_ONTO_TARGET_BRANCH -- "rebase-stuck" --> FAILURES_EXIT
  FIX_CONFLICTS -- "agent resolves the conflicts" --> COMMIT_MERGE_CONFLICT_FIX_IF_NEEDED
  COMMIT_MERGE_CONFLICT_FIX_IF_NEEDED -- "rebase finished" --> RUN_FULL_SUITE
  COMMIT_MERGE_CONFLICT_FIX_IF_NEEDED -- "stopped on new conflicts" --> FIX_CONFLICTS
  COMMIT_MERGE_CONFLICT_FIX_IF_NEEDED -- "rebase-stuck" --> FAILURES_EXIT
  RUN_FULL_SUITE -- "suite red" --> FIX_THE_CODEBASE_FOR_SUITE
  FIX_THE_CODEBASE_FOR_SUITE -- "agent fixes the codebase" --> RUN_FULL_SUITE
  RUN_FULL_SUITE -- "NONE LANDED<br/>the target branch tip moved" --> REBASE_ONTO_TARGET_BRANCH
  RUN_FULL_SUITE -- "suite-red<br/>fence-violation<br/>merge-failed<br/>partially-published" --> FAILURES_EXIT
  RUN_FULL_SUITE -- "ALL LANDED<br/>exit type: completed" --> STOP
  FAILURES_EXIT --> STOP
  REPORT_ONLY_EXIT --> STOP

  classDef script fill:#2f7d46,stroke:#1e5c31,color:#ffffff
  classDef returns_a_prompt fill:#e07b39,stroke:#a8541f,color:#1a1a1a
  classDef fail fill:red,stroke:#254a70,color:#ffffff
  classDef output fill:#3b6ea5,stroke:#254a70,color:#ffffff
  class PREAMBLE_STATUS_CHECK,DOCUMENT_GENERATION,WHAT_DID_THE_PLANNER_RETURN,WHAT_IS_REVIEW_VERDICT,COMMIT_IMPLEMENTATION_IF_NEEDED,ARE_TESTS_FLAGGED,LOCK_SOURCE_REPO,REBASE_ONTO_TARGET_BRANCH,COMMIT_MERGE_CONFLICT_FIX_IF_NEEDED,RUN_FULL_SUITE script
  class PLAN_THE_TASK,CODEX_REVIEWS_PLAN,IMPLEMENT_TASK,CODEX_REVIEWS_TESTS,FIX_CONFLICTS,FIX_THE_CODEBASE_FOR_SUITE returns_a_prompt
  class FAILURES_EXIT,REPORT_ONLY_EXIT fail
  class STOP output
