%% REVIEW TASK TESTS PIPELINE. Split from pipeline-implementTest.mmd.
%% Input: a green implementation from the task tests pipeline, together with the
%% plan, the tasks.json entry and the task's test files.
%% One job: decide whether the tests are worth trusting.
%% Starts at "codex reviews the tests". Ends with accepted tests, with the run
%% back in the implement pipeline, or with an exit.
%% Rules that apply everywhere, not steps:
%%   1. Every read and write of tasks.json is atomic.
%%   2. Codex gets two reviews. On the second flagging the pipeline aborts.
%%   3. Green tests are not the same as good tests. The test run decides whether
%%      the work is correct; this pipeline decides whether the tests prove it.
%%   4. A script that fails operationally, as opposed to returning a verdict,
%%      exits the run as run-failed. The task is already active and a worktree
%%      already exists here, so the exit workflow always runs in full.
%% Box definitions where the name alone is not enough:
%%   amend tasks.json entry       - the retry is not a bare retry. The implementor
%%                                  reads the task entry, so codex's notes and
%%                                  fixes are written into it or the next attempt
%%                                  repeats the same mistake.
%% Exit types this pipeline can produce:
%%   agent-failed       - an agent returned nothing usable
%%   tests-flagged      - codex flagged the tests twice
%%   run-failed         - a script failed operationally
%% run-failed is deliberately not drawn as an edge out of every box. It can leave
%% ANY green box, so drawing it would add one edge per box and hide the flow.
%% The finished implementation this pipeline emits is the input to the rebase
%% preamble pipeline.

  GREEN_IMPLEMENTATION_INPUT["Input: { plan, tasks.json entry,<br/>task test files }"] --> CODEX_REVIEWS_TESTS
  CODEX_REVIEWS_TESTS["codex reviews the tests"] --> ARE_TESTS_FLAGGED{"are the tests flagged?"}
  ARE_TESTS_FLAGGED --> ARE_TESTS_FLAGGED_NO["NO"]
  ARE_TESTS_FLAGGED --> ARE_TESTS_FLAGGED_YES["YES"]

  ARE_TESTS_FLAGGED_YES --> ARE_2_TEST_REVIEWS_DONE{"2 codex test reviews done?"}
  ARE_2_TEST_REVIEWS_DONE --> ARE_2_TEST_REVIEWS_DONE_NO["NO"]
  ARE_2_TEST_REVIEWS_DONE --> ARE_2_TEST_REVIEWS_DONE_YES["YES"]
  ARE_2_TEST_REVIEWS_DONE_NO --> AMEND_ENTRY_WITH_CODEX_NOTES["amend tasks.json entry with<br/>codex's notes and fixes"]
  AMEND_ENTRY_WITH_CODEX_NOTES -- "reimplement against the amended entry" --> IMPLEMENT_PIPELINE["implement pipeline"]
  ARE_2_TEST_REVIEWS_DONE_YES -- "exit type: tests-flagged<br/>exit note: task tests failed<br/>codex review" --> EXIT_WORKFLOW

  ARE_TESTS_FLAGGED_NO --> REBASE_PREAMBLE_PIPELINE["rebase preamble pipeline"]

  CODEX_REVIEWS_TESTS -.-> AGENT_ERRORED["agent() errored"] -- "exit type: agent-failed<br/>exit note: the agent returned<br/>nothing usable" --> EXIT_WORKFLOW

  EXIT_WORKFLOW["failures exit"]

  %% pass/nopass: green is the branch that keeps heading for the next pipeline,
  %% red is the branch that reimplements or ends in the exit workflow.
  classDef pipeline fill:#2f7d46,stroke:#1e5c31,color:#ffffff
  classDef script fill:#2f7d46,stroke:#1e5c31,color:#ffffff
  classDef agent fill:#e07b39,stroke:#a8541f,color:#1a1a1a
  classDef decision fill:#e0b400,stroke:#a88600,color:#1a1a1a
  classDef output fill:#3b6ea5,stroke:#254a70,color:#ffffff
  classDef fail fill:red,stroke:#254a70,color:#ffffff
  classDef pass fill:#2f7d46,stroke:#1e5c31,color:#ffffff
  classDef nopass fill:#a52a1e,stroke:#6d1a12,color:#ffffff
  class ARE_TESTS_FLAGGED,ARE_2_TEST_REVIEWS_DONE decision
  class AMEND_ENTRY_WITH_CODEX_NOTES script
  class CODEX_REVIEWS_TESTS agent
  class IMPLEMENT_PIPELINE,REBASE_PREAMBLE_PIPELINE pipeline
  class ARE_TESTS_FLAGGED_NO,ARE_2_TEST_REVIEWS_DONE_NO pass
  class ARE_TESTS_FLAGGED_YES,ARE_2_TEST_REVIEWS_DONE_YES nopass
  class AGENT_ERRORED nopass
  class EXIT_WORKFLOW fail
  class GREEN_IMPLEMENTATION_INPUT output
