%% EXIT WORKFLOW. Split from pipeline.mmd. Every pipeline ends here.
%% Two inputs, two tails:
%%   the merge receipt from the rebase and merge pipeline -> the success tail
%%   an exit type and exit note from any pipeline          -> the failure tail
%% Rules that apply everywhere, not steps:
%%   1. Every git interaction goes through a script. Never prose.
%%   2. Every read and write of tasks.json is atomic.
%%   3. Every box that touches the working tree operates on every repository
%%      layer, deepest submodule first, root last. Boxes that only read or write
%%      tasks.json do not.
%%   4. Exactly one box releases the source repo lock on the failure tail. The
%%      release line names only what is actually held: nothing before a
%%      worktree exists, the lease only before the source repo was locked, both
%%      after. "clean up" releases both on the success tail.
%%   5. A script that fails operationally, as opposed to returning a verdict,
%%      exits the run as run-failed. No step is retried after it has mutated
%%      anything. How far this workflow can run depends on where the failure
%%      happened, and there are four cases:
%%        before the task is active - report and stop; there is no run to write to
%%        active, no worktree      - this workflow runs; modified files records []
%%        active, with worktree    - this workflow runs in full
%%        during the archive, after "mark task inactive"
%%                                - the run is already ended, so this workflow
%%                                  reopens it, overwrites exit type completed
%%                                  with run-failed, and re-ends it
%%   6. A mutating box whose result is lost is never blindly retried and never
%%      assumed failed. Each one has a read-only reconciliation check that reads
%%      the world and decides whether it already happened. A safe idempotent
%%      rerun happens only after reconciliation proves it did not complete. Only
%%      an ambiguous loss is run-failed.
%%   7. A task stays unavailable to another run from "mark the task active" until
%%      its archive lands. "mark task inactive" ends the run but does NOT reopen
%%      the task: a task whose newest ended run exited completed, and which is
%%      still in tasks.json, is closing, and a second invocation must refuse it.
%% Exit types that reach [stop]:
%%   completed          - archived to completedTasks.json
%%   invalid-number     - not in tasks.json or completedTasks.json
%%   already-active     - a previous run left the task active
%%   blocked            - an open blocker remains
%%   plan-scrapped      - codex scrapped the plan twice
%%   tests-red          - task tests still failing after 2 fix attempts
%%   tests-flagged      - codex flagged the tests twice
%%   suite-red          - full suite still failing after 2 fix attempts
%%   rebase-stuck       - the rebase did not advance after 2 conflict fixes
%%   merge-failed       - the merge did not land twice
%%   fence-violation    - a step changed a file the task does not own
%%   run-failed         - a script failed operationally
%% invalid-number and already-active are the only exits that write nothing to
%% tasks.json: the first has no open task record to write to, and the second must
%% not touch a run that belongs to another invocation. Both take the report-only
%% tail. Every other exit takes the failure tail.

  MERGE_RECEIPT_INPUT["Input: { merge commit hashes, modified files }"] --> RECORD_MERGE_COMMIT_HASHES["record merge commit hashes to tasks.json"]
  RECORD_MERGE_COMMIT_HASHES --> WRITE_EXIT_TYPE_COMPLETED["write exit type completed to tasks.json"]
  WRITE_EXIT_TYPE_COMPLETED --> RECORD_MODIFIED_FILES_SUCCESS["record modified files to tasks.json"]
  RECORD_MODIFIED_FILES_SUCCESS --> CLEAN_UP_WORKTREES["clean up worktrees, leases,<br/>persistence refs and source lock"]
  CLEAN_UP_WORKTREES --> BUILD_CLOSURE_NOTE["build the closure note from the recorded run"]
  BUILD_CLOSURE_NOTE --> MARK_TASK_INACTIVE_SUCCESS["mark task inactive in tasks.json"]
  MARK_TASK_INACTIVE_SUCCESS --> ARCHIVE_TASK["move task to completedTasks.json<br/>and update tasks blocked by it"]
  ARCHIVE_TASK --> REPORT_CLOSURE_NOTE["report the closure note"]
  REPORT_CLOSURE_NOTE --> STOP["stop"]

  EXIT_TYPE_NOTE_INPUT["Input: { exitType, exitNote }"] --> WRITE_EXIT_TYPE_AND_NOTE["write exit type and exit notes to tasks.json"]
  WRITE_EXIT_TYPE_AND_NOTE --> RECORD_MODIFIED_FILES_FAILURE["record modified files to tasks.json"]
  RECORD_MODIFIED_FILES_FAILURE --> MARK_TASK_INACTIVE_FAILURE["mark task inactive in tasks.json"]
  MARK_TASK_INACTIVE_FAILURE --> WAS_WORKTREE_CREATED{"was a worktree created?"}
  WAS_WORKTREE_CREATED --> WAS_WORKTREE_CREATED_YES["YES"]
  WAS_WORKTREE_CREATED --> WAS_WORKTREE_CREATED_NO["NO"]
  WAS_WORKTREE_CREATED_NO --> NOTHING_TO_RELEASE["nothing to release"]
  NOTHING_TO_RELEASE --> REPORT_EXIT_TYPE_AND_NOTE["report the run's exit type and note"]

  WAS_WORKTREE_CREATED_YES --> WAS_SOURCE_REPO_LOCKED{"was the source repo locked?"}
  WAS_SOURCE_REPO_LOCKED --> WAS_SOURCE_REPO_LOCKED_YES["YES"]
  WAS_SOURCE_REPO_LOCKED --> WAS_SOURCE_REPO_LOCKED_NO["NO"]
  WAS_SOURCE_REPO_LOCKED_NO --> RELEASE_WORKTREE_LEASE["release the worktree lease"]
  RELEASE_WORKTREE_LEASE --> REPORT_EXIT_TYPE_AND_NOTE
  WAS_SOURCE_REPO_LOCKED_YES --> RELEASE_WORKTREE_LEASE_AND_LOCK["release the worktree lease and the source lock"]
  RELEASE_WORKTREE_LEASE_AND_LOCK --> REPORT_EXIT_TYPE_AND_NOTE
  REPORT_EXIT_TYPE_AND_NOTE --> STOP

  EXIT_TYPE_NOTE_NO_WRITE_INPUT["Input: { exitType, exitNote }<br/>invalid-number or already-active:<br/>no run record to write to"] --> REPORT_EXIT_TYPE_NO_WRITE["report the exit type and note"]
  REPORT_EXIT_TYPE_NO_WRITE --> STOP

  classDef script fill:#2f7d46,stroke:#1e5c31,color:#ffffff
  classDef prose fill:#e0b400,stroke:#a88600,color:#1a1a1a
  classDef decision fill:#e0b400,stroke:#a88600,color:#1a1a1a
  classDef output fill:#3b6ea5,stroke:#254a70,color:#ffffff
  classDef fail fill:red,stroke:#254a70,color:#ffffff
  classDef pass fill:#2f7d46,stroke:#1e5c31,color:#ffffff
  classDef nopass fill:#a52a1e,stroke:#6d1a12,color:#ffffff
  class WAS_WORKTREE_CREATED,WAS_SOURCE_REPO_LOCKED decision
  class WAS_WORKTREE_CREATED_YES,WAS_SOURCE_REPO_LOCKED_YES pass
  class WAS_WORKTREE_CREATED_NO,WAS_SOURCE_REPO_LOCKED_NO nopass
  class RECORD_MERGE_COMMIT_HASHES,WRITE_EXIT_TYPE_COMPLETED,RECORD_MODIFIED_FILES_SUCCESS,CLEAN_UP_WORKTREES,BUILD_CLOSURE_NOTE,MARK_TASK_INACTIVE_SUCCESS,ARCHIVE_TASK,REPORT_CLOSURE_NOTE,WRITE_EXIT_TYPE_AND_NOTE,RECORD_MODIFIED_FILES_FAILURE,MARK_TASK_INACTIVE_FAILURE,NOTHING_TO_RELEASE,RELEASE_WORKTREE_LEASE,RELEASE_WORKTREE_LEASE_AND_LOCK,REPORT_EXIT_TYPE_AND_NOTE,REPORT_EXIT_TYPE_NO_WRITE,STOP script
  class MERGE_RECEIPT_INPUT,EXIT_TYPE_NOTE_INPUT,EXIT_TYPE_NOTE_NO_WRITE_INPUT output
