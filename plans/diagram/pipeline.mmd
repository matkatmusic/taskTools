%% OVERVIEW. One block per pipeline. Each block is drawn in full in its own file:
%%   preamble pipeline           pipeline-preamble.mmd
%%   planning pipeline           pipeline-planning.mmd
%%   implement and test pipeline pipeline-implementTest.mmd
%%   rebase and merge pipeline   pipeline-rebaseMerge.mmd
%%   exit workflow               pipeline-exitWorkflow.mmd
%% The dotted arrow out of each block is that block's early exit, drawn as one
%% arrow here. The exit types it carries are listed in that block's own file.
%% Every "exit workflow" box is the SAME workflow, drawn once per caller so the
%% arrows stay readable.
%% Every pipeline emits a white Receipt block, on both paths: the success receipt
%% is the next pipeline's input, the failure receipt is the exit workflow's.
%% Exit types, one per path that reaches [stop]:
%%   completed          - archived to completedTasks.json
%%   invalid-number     - not in tasks.json or completedTasks.json
%%   already-active     - a previous run left the task active
%%   blocked            - an open blocker remains
%%   plan-scrapped      - codex scrapped the plan twice
%%   tests-red          - task tests still failing after 2 fix attempts
%%   tests-flagged      - codex flagged the tests twice
%%   suite-red          - full suite still failing after 2 fix attempts
%%   rebase-stuck       - the rebase did not advance after 2 conflict fixes
%%   merge-failed       - the merge did not land twice
%%   fence-violation    - a step changed a file the task does not own
%%   run-failed         - a script failed operationally; can leave ANY green box
%%                        in any pipeline

  TASK_NUMBER_INPUT["Input: { task number }"] --> PREAMBLE_PIPELINE["preamble pipeline"]
  PREAMBLE_PIPELINE --> PREAMBLE_PIPELINE_SUCCESS["SUCCESS"] --> ACTIVE_TASK_WORKTREE_RECEIPT["Receipt: { active task, initialized worktree }"]
  ACTIVE_TASK_WORKTREE_RECEIPT --> PLANNING_PIPELINE["planning pipeline"]
  PLANNING_PIPELINE --> PLANNING_PIPELINE_SUCCESS["SUCCESS"] --> PLAN_FILE_RECEIPT["Receipt: { plan file }"]
  PLAN_FILE_RECEIPT --> IMPLEMENT_AND_TEST_PIPELINE["implement and test pipeline"]
  IMPLEMENT_AND_TEST_PIPELINE --> IMPLEMENT_AND_TEST_PIPELINE_SUCCESS["SUCCESS"] --> FINISHED_IMPLEMENTATION_RECEIPT["Receipt: { finished implementation, source repo lock }"]
  FINISHED_IMPLEMENTATION_RECEIPT --> REBASE_AND_MERGE_PIPELINE["rebase and merge pipeline"]
  REBASE_AND_MERGE_PIPELINE --> REBASE_AND_MERGE_PIPELINE_SUCCESS["SUCCESS"] --> MERGE_RECEIPT["Receipt: { merge commit hashes, modified files }"]
  MERGE_RECEIPT --> EXIT_WORKFLOW_SUCCESS["exit workflow"]
  EXIT_WORKFLOW_SUCCESS --> STOP["stop"]

  PREAMBLE_PIPELINE -.-> PREAMBLE_PIPELINE_FAIL["FAILED"]
  PREAMBLE_PIPELINE_FAIL --> PIPELINE_FAILURE_RECEIPT["Receipt: { exitType, exitNote }"]
  PIPELINE_FAILURE_RECEIPT --> EXIT_WORKFLOW_FAILURE["exit workflow"]

  PLANNING_PIPELINE -.-> PLANNING_PIPELINE_FAIL["FAILED"] --> PIPELINE_FAILURE_RECEIPT
  IMPLEMENT_AND_TEST_PIPELINE -.-> IMPLEMENT_AND_TEST_PIPELINE_FAIL["FAILED"] --> PIPELINE_FAILURE_RECEIPT

  REBASE_AND_MERGE_PIPELINE -.-> REBASE_AND_MERGE_PIPELINE_FAIL["FAILED"] --> PIPELINE_FAILURE_RECEIPT
  EXIT_WORKFLOW_FAILURE --> STOP

  classDef pipeline fill:#2f7d46,stroke:#1e5c31,color:#ffffff
  classDef receipt fill:#ffffff,stroke:#333333,color:#000000
  classDef output fill:#3b6ea5,stroke:#254a70,color:#ffffff
  classDef fail fill:red,stroke:#254a70,color:#ffffff
  classDef nopass fill:#a52a1e,stroke:#6d1a12,color:#ffffff
  classDef pass fill:#00ff00,stroke:#6d1a12,color:#000000
  class PREAMBLE_PIPELINE,PLANNING_PIPELINE,IMPLEMENT_AND_TEST_PIPELINE,REBASE_AND_MERGE_PIPELINE,EXIT_WORKFLOW_SUCCESS pipeline
  class ACTIVE_TASK_WORKTREE_RECEIPT,PLAN_FILE_RECEIPT,FINISHED_IMPLEMENTATION_RECEIPT,MERGE_RECEIPT,PIPELINE_FAILURE_RECEIPT receipt
  class PREAMBLE_PIPELINE_SUCCESS,PLANNING_PIPELINE_SUCCESS,IMPLEMENT_AND_TEST_PIPELINE_SUCCESS,REBASE_AND_MERGE_PIPELINE_SUCCESS pass
  class PREAMBLE_PIPELINE_FAIL,PLANNING_PIPELINE_FAIL,IMPLEMENT_AND_TEST_PIPELINE_FAIL,REBASE_AND_MERGE_PIPELINE_FAIL nopass
  class EXIT_WORKFLOW_FAILURE fail
  class TASK_NUMBER_INPUT,STOP output
