%% FULL SUITE PIPELINE. Split from pipeline-rebaseMerge.mmd.
%% ---
%% Input: a rebased worktree, with the source repo lock already held.
%% ---
%% Job: get the whole test suite green on the target branch.
%% ---
%% Rules not shown in the graph:
%% ---
%% The fence gate runs once, after the fix loop and before the merge.
%% ---
%% It re-derives the diff itself and never trusts an agent's self-report.
%% ---
%% See checkTaskFileFence.ts.
%% ---
%% Counters count fix attempts, not failing runs.
%% ---
%% They are per-invocation, not persisted to tasks.json.
%% ---
%% KNOWN CEILING: the source lock goes stale at 15 minutes.
%% ---
%% Refreshes happen only between boxes, no background timer.
%% ---
%% See sourceRepoLock.ts, no setInterval.
%% ---
%% A script that fails operationally exits as run-failed.
%% ---
%% Exit types: agent-failed, suite-red, fence-violation, run-failed.

  REBASED_WORKTREE_INPUT["Input: { worktree }"] --> RUN_FULL_SUITE
  RUN_FULL_SUITE["Try: run the full suite"] --> DO_ALL_TESTS_PASS{"do all tests pass?"}
  DO_ALL_TESTS_PASS --> DO_ALL_TESTS_PASS_YES["YES"]
  DO_ALL_TESTS_PASS --> DO_ALL_TESTS_PASS_NO["NO"]

  DO_ALL_TESTS_PASS_NO --> ARE_2_SUITE_FIXES_DONE{"2 suite fix attempts done?"}
  ARE_2_SUITE_FIXES_DONE --> ARE_2_SUITE_FIXES_DONE_NO["NO"]
  ARE_2_SUITE_FIXES_DONE --> ARE_2_SUITE_FIXES_DONE_YES["YES"]
  ARE_2_SUITE_FIXES_DONE_NO -- "pass the failing tests to the agent" --> FIX_THE_CODEBASE_FOR_SUITE["fix the codebase so<br/>the full suite passes"]
  FIX_THE_CODEBASE_FOR_SUITE --> COMMIT_IF_NEEDED["commit if needed"]
  COMMIT_IF_NEEDED --> RUN_FULL_SUITE
  ARE_2_SUITE_FIXES_DONE_YES -- "exit type: suite-red<br/>exit note: full suite still red after<br/>2 fix attempts. merge aborted.<br/>worktree preserved." --> EXIT_WORKFLOW

  DO_ALL_TESTS_PASS_YES --> DID_CHANGES_STAY_INSIDE_FENCE{"did every change stay inside<br/>the task's file fence?"}
  DID_CHANGES_STAY_INSIDE_FENCE --> DID_CHANGES_STAY_INSIDE_FENCE_YES["YES"]
  DID_CHANGES_STAY_INSIDE_FENCE --> DID_CHANGES_STAY_INSIDE_FENCE_NO["NO"]
  DID_CHANGES_STAY_INSIDE_FENCE_YES --> MERGE_PIPELINE["merge pipeline"]
  DID_CHANGES_STAY_INSIDE_FENCE_NO -- "exit type: fence-violation<br/>exit note: a repair edited files the<br/>task does not own. nothing merged.<br/>worktree preserved." --> EXIT_WORKFLOW

  FIX_THE_CODEBASE_FOR_SUITE -.-> AGENT_ERRORED["agent() errored"] -- "exit type: agent-failed<br/>exit note: the agent returned<br/>nothing usable" --> EXIT_WORKFLOW

  EXIT_WORKFLOW["failures exit"]

  %% Green heads for the next pipeline.
  %% ---
  %% Red goes back round the cycle or ends in the exit workflow.
  classDef pipeline fill:#2f7d46,stroke:#1e5c31,color:#ffffff
  classDef script fill:#2f7d46,stroke:#1e5c31,color:#ffffff
  classDef agent fill:#e07b39,stroke:#a8541f,color:#1a1a1a
  classDef decision fill:#e0b400,stroke:#a88600,color:#1a1a1a
  classDef output fill:#3b6ea5,stroke:#254a70,color:#ffffff
  classDef fail fill:red,stroke:#254a70,color:#ffffff
  classDef pass fill:#2f7d46,stroke:#1e5c31,color:#ffffff
  classDef nopass fill:#a52a1e,stroke:#6d1a12,color:#ffffff
  class DO_ALL_TESTS_PASS,ARE_2_SUITE_FIXES_DONE,DID_CHANGES_STAY_INSIDE_FENCE decision
  class RUN_FULL_SUITE,COMMIT_IF_NEEDED script
  class FIX_THE_CODEBASE_FOR_SUITE agent
  class MERGE_PIPELINE pipeline
  class DO_ALL_TESTS_PASS_YES,ARE_2_SUITE_FIXES_DONE_NO,DID_CHANGES_STAY_INSIDE_FENCE_YES pass
  class DO_ALL_TESTS_PASS_NO,ARE_2_SUITE_FIXES_DONE_YES,DID_CHANGES_STAY_INSIDE_FENCE_NO nopass
  class AGENT_ERRORED nopass
  class EXIT_WORKFLOW fail
  class REBASED_WORKTREE_INPUT output
