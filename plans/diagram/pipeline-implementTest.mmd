%% IMPLEMENT AND TEST PIPELINE. Split from pipeline.mmd.
%% Input: the plan file from the planning pipeline.
%% Starts at "implement task".
%% Ends by locking the source repo and handing a finished implementation to the
%% rebase and merge pipeline, or with an exit.
%% Rules that apply everywhere, not steps:
%%   1. Every git interaction goes through a script. Never prose.
%%   2. Every read and write of tasks.json is atomic.
%%   3. Never update a test that was not created in this task's worktree,
%%      unless that test is broken or asserts nothing.
%%   4. "fix the codebase" edits source, not tests.
%%   5. Never progress past a suite run until every test passes.
%%   6. Every test loop runs commit the work -> test the work -> repair the work.
%%      A repair is never tested until it is committed, so each loop re-enters at
%%      its "commit if needed" box, never at the test box.
%%   7. "commit if needed" commits nothing when the worktree is clean. Its message
%%      is derived, not chosen: the run's first commit is the work, and every
%%      commit after it is a repair to code that made tests fail.
%%      TO BUILD: "amend the tests" should return a commit message in its receipt,
%%      and "commit if needed" should use it. The amender is the only thing that
%%      knows WHICH reviewer notes it applied; a message derived from position in
%%      the loop can only say "a repair", which is the same line every round.
%%      Receipt becomes { amended, commitMessage }. Not implemented: today the
%%      agent returns only {amended} - see reviewTestsPrompt's sibling in
%%      scripts/tackle-tasks/AgentPromptEmitter.ts.
%%   8. Every box that touches the working tree operates on every repository
%%      layer, deepest submodule first, root last: commit and run tests both walk
%%      the same occurrence tree. Boxes that only read or write tasks.json do not.
%%   9. A script that fails operationally, as opposed to returning a verdict,
%%      exits the run as run-failed. No step is retried after it has mutated
%%      anything. The task is already active and a worktree already exists here,
%%      so the exit workflow always runs in full.
%%  10. "lock the source repo" holds one lock on the source repository for the
%%      whole tail of the run, across the rebase and merge pipeline and the exit
%%      workflow. The lock is a durable file, acquired and released by different
%%      processes, owned by "runId:taskNumber" - NOT by runId alone, because
%%      every task workflow in one invocation shares a runId and would otherwise
%%      read a sibling's lock as its own. Exactly one box releases it: "clean up"
%%      on success, "release the worktree lease and the source lock if held" on
%%      every exit. Both live in the exit workflow.
%%      Taking it is two boxes, not one: "can the source repo be locked?" reads
%%      whether it is free, then "lock the source repo" takes it. Each has its
%%      own two-strike wait. Held by someone else: wait once, ask again, and exit
%%      on the second refusal. Acquire failed after the read said free: another
%%      run won the race, so wait once and re-ask the same question, and exit on
%%      the second failure.
%%      Exiting here is not a lost run. The work is committed and the worktree
%%      is left resumable, so the next invocation of this task picks it up.
%%      An exit here has NOT taken the lock, so the exit workflow releases the
%%      worktree lease only. See acquireSourceRepoLock in
%%      scripts/tackle-tasks/sourceRepoLock.ts.
%%  11. A mutating box whose result is lost is never blindly retried and never
%%      assumed failed. Each one, including a test box that records its result,
%%      has a read-only reconciliation check that reads the world and decides
%%      whether it already happened. A safe idempotent rerun happens only after
%%      reconciliation proves it did not complete. Only an ambiguous loss is
%%      run-failed.
%% Diamond definitions where the name alone is not enough:
%%   do the task tests pass?           - the test run alone decides this; codex
%%                                       judges the tests, the tests judge the work
%% Exit types this pipeline can produce:
%%   tests-red          - task tests still failing after 2 fix attempts
%%   tests-flagged      - codex flagged the tests twice
%%   run-failed         - a script failed operationally
%% run-failed is deliberately not drawn as an edge. It can leave ANY green box,
%% so drawing it would add one edge per box and hide the flow. Rule 9 is its
%% specification: a non-zero exit from any script goes straight to the exit
%% workflow with exit type run-failed and the script's stderr as the note.
%% The committed, green implementation this pipeline emits is the input to the
%% rebase and merge pipeline.

  PLAN_FILE_INPUT["Input: { plan file }"] --> IMPLEMENT_TASK
  IMPLEMENT_TASK["implement task"] --> RECORD_IMPLEMENTATION_NOTES["record implementation notes<br/>file to tasks.json"]
  RECORD_IMPLEMENTATION_NOTES --> COMMIT_IF_NEEDED["commit if needed"]
  COMMIT_IF_NEEDED --> RUN_TASK_TESTS["Try: run task tests"]
  RUN_TASK_TESTS --> DO_TASK_TESTS_FAIL{"do the tests fail?"}
  DO_TASK_TESTS_FAIL --> DO_TASK_TESTS_FAIL_YES["YES"]
  DO_TASK_TESTS_FAIL --> DO_TASK_TESTS_FAIL_NO["NO"]

  DO_TASK_TESTS_FAIL_YES --> IS_FIRST_TASK_TEST_FAIL{"First fail?"}
  IS_FIRST_TASK_TEST_FAIL --> IS_FIRST_TASK_TEST_FAIL_YES["YES"]
  IS_FIRST_TASK_TEST_FAIL --> IS_FIRST_TASK_TEST_FAIL_NO["NO"]
  IS_FIRST_TASK_TEST_FAIL_YES --> FIX_THE_CODEBASE["fix the codebase"]
  FIX_THE_CODEBASE --> FIXED_CODEBASE_OUTPUT["Output"]
  FIXED_CODEBASE_OUTPUT --> FIXED_CODEBASE_RECEIPT["Receipt: { fixed }"]
  FIXED_CODEBASE_RECEIPT --> IS_FIX_RECEIPT_VALID{"is the fix receipt structure valid?"}
  IS_FIX_RECEIPT_VALID --> IS_FIX_RECEIPT_VALID_YES["YES"]
  IS_FIX_RECEIPT_VALID --> IS_FIX_RECEIPT_VALID_NO["NO"]
  IS_FIX_RECEIPT_VALID_YES --> FIXED_CODEBASE_OUTPUT_TRUSTED["Output"]
  FIXED_CODEBASE_OUTPUT_TRUSTED --> FIXED_CODEBASE_RECEIPT_TRUSTED["Receipt: { fixed }"]
  FIXED_CODEBASE_RECEIPT_TRUSTED --> COMMIT_IF_NEEDED
  IS_FIX_RECEIPT_VALID_NO -- "exit type: run-failed<br/>exit note: the fix receipt<br/>is malformed" --> VALIDATOR_FAILURE_OUTPUT
  IS_FIRST_TASK_TEST_FAIL_NO --> TESTS_FAILED_2X["2nd fail"]
  TESTS_FAILED_2X -- "exit type: tests-red<br/>exit note: task tests failed<br/>after 2 codebase fixes" --> EXIT_WORKFLOW

  DO_TASK_TESTS_FAIL_NO --> CODEX_REVIEWS_TESTS["codex reviews tests against<br/>task details and plan file"]
  CODEX_REVIEWS_TESTS --> TEST_REVIEW_OUTPUT["Output"]
  TEST_REVIEW_OUTPUT --> TEST_REVIEW_RECEIPT["Receipt: { flagged, reviewer,<br/>test review file }"]
  TEST_REVIEW_RECEIPT --> IS_TEST_REVIEW_RECEIPT_VALID{"is the test review receipt structure valid?"}
  IS_TEST_REVIEW_RECEIPT_VALID --> IS_TEST_REVIEW_RECEIPT_VALID_YES["YES"]
  IS_TEST_REVIEW_RECEIPT_VALID --> IS_TEST_REVIEW_RECEIPT_VALID_NO["NO"]
  IS_TEST_REVIEW_RECEIPT_VALID_YES --> TEST_REVIEW_OUTPUT_TRUSTED["Output"]
  TEST_REVIEW_OUTPUT_TRUSTED --> TEST_REVIEW_RECEIPT_TRUSTED["Receipt: { flagged, reviewer,<br/>test review file }"]
  TEST_REVIEW_RECEIPT_TRUSTED --> ARE_TESTS_FLAGGED{"are the tests flagged?"}
  IS_TEST_REVIEW_RECEIPT_VALID_NO -- "exit type: run-failed<br/>exit note: the test review<br/>receipt is malformed" --> VALIDATOR_FAILURE_OUTPUT
  ARE_TESTS_FLAGGED --> ARE_TESTS_FLAGGED_YES["YES"]
  ARE_TESTS_FLAGGED --> ARE_TESTS_FLAGGED_NO["NO"]

  ARE_TESTS_FLAGGED_YES --> IS_FIRST_FLAGGING{"First flagging?"}
  IS_FIRST_FLAGGING --> IS_FIRST_FLAGGING_YES["YES"]
  IS_FIRST_FLAGGING --> IS_FIRST_FLAGGING_NO["NO"]
  IS_FIRST_FLAGGING_YES --> AMEND_TESTS["amend the tests"]
  AMEND_TESTS --> AMEND_TESTS_OUTPUT["Output"]
  AMEND_TESTS_OUTPUT --> AMEND_TESTS_RECEIPT["Receipt: { amended }"]
  AMEND_TESTS_RECEIPT --> IS_AMENDMENT_RECEIPT_VALID{"is the amendment receipt structure valid?"}
  IS_AMENDMENT_RECEIPT_VALID --> IS_AMENDMENT_RECEIPT_VALID_YES["YES"]
  IS_AMENDMENT_RECEIPT_VALID --> IS_AMENDMENT_RECEIPT_VALID_NO["NO"]
  IS_AMENDMENT_RECEIPT_VALID_YES --> AMEND_TESTS_OUTPUT_TRUSTED["Output"]
  AMEND_TESTS_OUTPUT_TRUSTED --> AMEND_TESTS_RECEIPT_TRUSTED["Receipt: { amended }"]
  AMEND_TESTS_RECEIPT_TRUSTED --> COMMIT_IF_NEEDED
  IS_AMENDMENT_RECEIPT_VALID_NO -- "exit type: run-failed<br/>exit note: the amendment<br/>receipt is malformed" --> VALIDATOR_FAILURE_OUTPUT
  IS_FIRST_FLAGGING_NO --> TESTS_FLAGGED_2X["2nd flagging"]
  TESTS_FLAGGED_2X -- "exit type: tests-flagged<br/>exit note: codex flagged<br/>the tests twice" --> EXIT_WORKFLOW

  ARE_TESTS_FLAGGED_NO --> CAN_SOURCE_REPO_BE_LOCKED{"can the source repo be locked?"}
  CAN_SOURCE_REPO_BE_LOCKED --> CAN_SOURCE_REPO_BE_LOCKED_YES["YES"]
  CAN_SOURCE_REPO_BE_LOCKED --> CAN_SOURCE_REPO_BE_LOCKED_NO["NO"]

  CAN_SOURCE_REPO_BE_LOCKED_YES --> LOCK_SOURCE_REPO["Try: lock the source repo"]
  LOCK_SOURCE_REPO --> DID_LOCKING_SOURCE_REPO_SUCCEED{"did locking the source repo succeed?"}
  DID_LOCKING_SOURCE_REPO_SUCCEED --> DID_LOCKING_SOURCE_REPO_SUCCEED_YES["YES"]
  DID_LOCKING_SOURCE_REPO_SUCCEED --> DID_LOCKING_SOURCE_REPO_SUCCEED_NO["NO"]
  DID_LOCKING_SOURCE_REPO_SUCCEED_YES --> FINISHED_IMPLEMENTATION_OUTPUT

  CAN_SOURCE_REPO_BE_LOCKED_NO --> IS_FIRST_TIME_HELD{"First time held?"}
  IS_FIRST_TIME_HELD --> IS_FIRST_TIME_HELD_YES["YES"]
  IS_FIRST_TIME_HELD --> IS_FIRST_TIME_HELD_NO["NO"]
  IS_FIRST_TIME_HELD_YES --> WAIT_FOR_LOCK_FREE["Try: wait"]
  WAIT_FOR_LOCK_FREE --> CAN_SOURCE_REPO_BE_LOCKED
  IS_FIRST_TIME_HELD_NO --> SOURCE_REPO_HELD_2X["2nd time held"]
  SOURCE_REPO_HELD_2X -- "exit type: run-failed<br/>exit note: the source repo lock is<br/>held by another owner" --> EXIT_WORKFLOW

  DID_LOCKING_SOURCE_REPO_SUCCEED_NO --> IS_FIRST_LOCK_FAILURE{"First lock failure?"}
  IS_FIRST_LOCK_FAILURE --> IS_FIRST_LOCK_FAILURE_YES["YES"]
  IS_FIRST_LOCK_FAILURE --> IS_FIRST_LOCK_FAILURE_NO["NO"]
  IS_FIRST_LOCK_FAILURE_YES --> WAIT_AFTER_LOCK_RACE["Try: wait"]
  WAIT_AFTER_LOCK_RACE --> CAN_SOURCE_REPO_BE_LOCKED
  IS_FIRST_LOCK_FAILURE_NO --> LOCK_FAILED_2X["2nd lock failure"]
  LOCK_FAILED_2X -- "exit type: run-failed<br/>exit note: the source repo lock<br/>could not be acquired" --> EXIT_WORKFLOW

  FINISHED_IMPLEMENTATION_OUTPUT["Output"] --> FINISHED_IMPLEMENTATION_RECEIPT["Receipt: { finished implementation, source repo lock }"]
  FINISHED_IMPLEMENTATION_RECEIPT --> IS_FINISHED_IMPLEMENTATION_RECEIPT_VALID{"is the finished implementation receipt structure valid?"}
  IS_FINISHED_IMPLEMENTATION_RECEIPT_VALID --> IS_FINISHED_IMPLEMENTATION_RECEIPT_VALID_YES["YES"]
  IS_FINISHED_IMPLEMENTATION_RECEIPT_VALID --> IS_FINISHED_IMPLEMENTATION_RECEIPT_VALID_NO["NO"]
  IS_FINISHED_IMPLEMENTATION_RECEIPT_VALID_YES --> FINISHED_IMPLEMENTATION_OUTPUT_TRUSTED["Output"]
  FINISHED_IMPLEMENTATION_OUTPUT_TRUSTED --> FINISHED_IMPLEMENTATION_RECEIPT_TRUSTED["Receipt: { finished implementation, source repo lock }"]
  IS_FINISHED_IMPLEMENTATION_RECEIPT_VALID_NO -- "exit type: run-failed<br/>exit note: the finished implementation<br/>receipt is malformed" --> VALIDATOR_FAILURE_OUTPUT

  VALIDATOR_FAILURE_OUTPUT["Output"] --> VALIDATOR_FAILURE_RECEIPT["Receipt: { exitType, exitNote }"]
  VALIDATOR_FAILURE_RECEIPT --> EXIT_WORKFLOW

  EXIT_WORKFLOW["exit workflow"] --> EXIT_OUTPUT["Output"]
  EXIT_OUTPUT --> EXIT_RECEIPT["Receipt: { exitType, exitNote }"]

  %% pass/nopass: green is the branch that keeps heading for the receipt,
  %% red is the branch that ends in the exit workflow.
  classDef script fill:#2f7d46,stroke:#1e5c31,color:#ffffff
  classDef agent fill:#e07b39,stroke:#a8541f,color:#1a1a1a
  classDef decision fill:#e0b400,stroke:#a88600,color:#1a1a1a
  classDef receipt fill:#ffffff,stroke:#333333,color:#000000
  classDef output fill:#3b6ea5,stroke:#254a70,color:#ffffff
  classDef fail fill:red,stroke:#254a70,color:#ffffff
  classDef verdict fill:#4a4a4a,stroke:#8a8a8a,color:#ffffff
  classDef pass fill:#2f7d46,stroke:#1e5c31,color:#ffffff
  classDef nopass fill:#a52a1e,stroke:#6d1a12,color:#ffffff
  class DO_TASK_TESTS_FAIL,IS_FIRST_TASK_TEST_FAIL,ARE_TESTS_FLAGGED,IS_FIRST_FLAGGING,CAN_SOURCE_REPO_BE_LOCKED,IS_FIRST_TIME_HELD,DID_LOCKING_SOURCE_REPO_SUCCEED,IS_FIRST_LOCK_FAILURE,IS_FIX_RECEIPT_VALID,IS_TEST_REVIEW_RECEIPT_VALID,IS_AMENDMENT_RECEIPT_VALID,IS_FINISHED_IMPLEMENTATION_RECEIPT_VALID decision
  class RECORD_IMPLEMENTATION_NOTES,COMMIT_IF_NEEDED,RUN_TASK_TESTS,WAIT_FOR_LOCK_FREE,LOCK_SOURCE_REPO,WAIT_AFTER_LOCK_RACE script
  class IMPLEMENT_TASK,CODEX_REVIEWS_TESTS,FIX_THE_CODEBASE,AMEND_TESTS agent
  class TESTS_FAILED_2X,TESTS_FLAGGED_2X,SOURCE_REPO_HELD_2X,LOCK_FAILED_2X verdict
  class DO_TASK_TESTS_FAIL_NO,IS_FIRST_TASK_TEST_FAIL_YES,ARE_TESTS_FLAGGED_NO,IS_FIRST_FLAGGING_YES,CAN_SOURCE_REPO_BE_LOCKED_YES,IS_FIRST_TIME_HELD_YES,DID_LOCKING_SOURCE_REPO_SUCCEED_YES,IS_FIRST_LOCK_FAILURE_YES,IS_FIX_RECEIPT_VALID_YES,IS_TEST_REVIEW_RECEIPT_VALID_YES,IS_AMENDMENT_RECEIPT_VALID_YES,IS_FINISHED_IMPLEMENTATION_RECEIPT_VALID_YES pass
  class DO_TASK_TESTS_FAIL_YES,IS_FIRST_TASK_TEST_FAIL_NO,ARE_TESTS_FLAGGED_YES,IS_FIRST_FLAGGING_NO,CAN_SOURCE_REPO_BE_LOCKED_NO,IS_FIRST_TIME_HELD_NO,DID_LOCKING_SOURCE_REPO_SUCCEED_NO,IS_FIRST_LOCK_FAILURE_NO,IS_FIX_RECEIPT_VALID_NO,IS_TEST_REVIEW_RECEIPT_VALID_NO,IS_AMENDMENT_RECEIPT_VALID_NO,IS_FINISHED_IMPLEMENTATION_RECEIPT_VALID_NO nopass
  class EXIT_WORKFLOW fail
  class PLAN_FILE_INPUT,FINISHED_IMPLEMENTATION_OUTPUT_TRUSTED,EXIT_OUTPUT,FIXED_CODEBASE_OUTPUT,FIXED_CODEBASE_OUTPUT_TRUSTED,TEST_REVIEW_OUTPUT,TEST_REVIEW_OUTPUT_TRUSTED,AMEND_TESTS_OUTPUT,AMEND_TESTS_OUTPUT_TRUSTED,FINISHED_IMPLEMENTATION_OUTPUT,VALIDATOR_FAILURE_OUTPUT output
  class FIXED_CODEBASE_RECEIPT,TEST_REVIEW_RECEIPT,AMEND_TESTS_RECEIPT,FINISHED_IMPLEMENTATION_RECEIPT,EXIT_RECEIPT,FIXED_CODEBASE_RECEIPT_TRUSTED,TEST_REVIEW_RECEIPT_TRUSTED,AMEND_TESTS_RECEIPT_TRUSTED,FINISHED_IMPLEMENTATION_RECEIPT_TRUSTED,VALIDATOR_FAILURE_RECEIPT receipt
