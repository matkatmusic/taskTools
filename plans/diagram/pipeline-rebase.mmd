%% REBASE PIPELINE.
%% ---
%% Input: a finished implementation.
%% ---
%% Job: put the task's commits on top of the target branch.
%% ---
%% A conflict fix runs fix, then commit, then continue.
%% ---
%% Never fix then continue without committing first.
%% ---
%% The source lock is already held here.
%% ---
%% Every box refreshes the lock's heartbeat.
%% ---
%% Walks every repository layer, deepest submodule first.
%% ---
%% The receipt names layers already landed by the merge.
%% ---
%% A landed layer is public. Rebasing it would rewrite it.
%% ---
%% So this pipeline skips any layer the receipt marks landed.
%% ---
%% Merge re-enters here only when nothing landed.
%% ---
%% So the receipt is normally empty, but check, don't assume.
%% ---
%% Exit types: agent-failed, rebase-stuck, run-failed.
%% ---
%% Output feeds the full suite pipeline.

  SOURCE_REPO_LOCKED_INPUT["Input: { worktree, target branch,<br/>merge receipt }"] --> REBASE_ONTO_TARGET_BRANCH
  REBASE_ONTO_TARGET_BRANCH["Try: rebase onto the target branch.<br/>skip every layer the receipt<br/>records as already landed"] --> DID_REBASE_REPORT_CONFLICTS{"did the rebase report conflicts?"}
  DID_REBASE_REPORT_CONFLICTS --> DID_REBASE_REPORT_CONFLICTS_YES["YES"]
  DID_REBASE_REPORT_CONFLICTS --> DID_REBASE_REPORT_CONFLICTS_NO["NO"]

  DID_REBASE_REPORT_CONFLICTS_YES --> ARE_2_CONFLICT_FIXES_DONE{"2 conflict fixes done?"}
  ARE_2_CONFLICT_FIXES_DONE --> ARE_2_CONFLICT_FIXES_DONE_NO["NO"]
  ARE_2_CONFLICT_FIXES_DONE --> ARE_2_CONFLICT_FIXES_DONE_YES["YES"]
  ARE_2_CONFLICT_FIXES_DONE_YES -- "exit type: rebase-stuck<br/>exit note: the rebase did not advance<br/>after 2 conflict fixes" --> EXIT_WORKFLOW
  ARE_2_CONFLICT_FIXES_DONE_NO -- "pass the stopped layer and<br/>its conflicted files to the agent" --> FIX_CONFLICTS["fix conflicts"]
  FIX_CONFLICTS --> COMMIT_IF_NEEDED["commit if needed"]
  COMMIT_IF_NEEDED --> CONTINUE_REBASE["Try: continue the rebase"]
  CONTINUE_REBASE --> IS_REBASE_FINISHED{"is the rebase finished?"}
  IS_REBASE_FINISHED --> IS_REBASE_FINISHED_YES["YES"]
  IS_REBASE_FINISHED --> IS_REBASE_FINISHED_NO["NO"]
  IS_REBASE_FINISHED_NO -- "it stopped on new conflicts" --> DID_REBASE_REPORT_CONFLICTS

  DID_REBASE_REPORT_CONFLICTS_NO --> SUITE_PIPELINE
  IS_REBASE_FINISHED_YES --> SUITE_PIPELINE["full suite pipeline"]

  FIX_CONFLICTS -.-> AGENT_ERRORED["agent() errored"] -- "exit type: agent-failed<br/>exit note: the agent returned<br/>nothing usable" --> EXIT_WORKFLOW

  EXIT_WORKFLOW["failures exit"]

  %% pass/nopass: green heads to the next pipeline.
  %% ---
  %% Red goes back round the conflict cycle.
  classDef pipeline fill:#2f7d46,stroke:#1e5c31,color:#ffffff
  classDef script fill:#2f7d46,stroke:#1e5c31,color:#ffffff
  classDef agent fill:#e07b39,stroke:#a8541f,color:#1a1a1a
  classDef decision fill:#e0b400,stroke:#a88600,color:#1a1a1a
  classDef output fill:#3b6ea5,stroke:#254a70,color:#ffffff
  classDef fail fill:red,stroke:#254a70,color:#ffffff
  classDef pass fill:#2f7d46,stroke:#1e5c31,color:#ffffff
  classDef nopass fill:#a52a1e,stroke:#6d1a12,color:#ffffff
  class AGENT_ERRORED nopass
  class EXIT_WORKFLOW fail
  class DID_REBASE_REPORT_CONFLICTS,IS_REBASE_FINISHED,ARE_2_CONFLICT_FIXES_DONE decision
  class REBASE_ONTO_TARGET_BRANCH,COMMIT_IF_NEEDED,CONTINUE_REBASE script
  class FIX_CONFLICTS agent
  class SUITE_PIPELINE pipeline
  class DID_REBASE_REPORT_CONFLICTS_NO,IS_REBASE_FINISHED_YES,ARE_2_CONFLICT_FIXES_DONE_NO pass
  class DID_REBASE_REPORT_CONFLICTS_YES,IS_REBASE_FINISHED_NO,ARE_2_CONFLICT_FIXES_DONE_YES nopass
  class SOURCE_REPO_LOCKED_INPUT output
