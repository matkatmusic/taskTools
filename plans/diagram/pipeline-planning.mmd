%% PLANNING PIPELINE. Split from pipeline.mmd.
%% HAPPY PATH ONLY. The loops and the early exits are not drawn yet.
%% Input: an initialized worktree and an active task from the preamble pipeline.
%% Starts at "plan the task". Ends with a plan file.
%% Rules that apply everywhere, not steps:
%%   1. Every git interaction goes through a script. Never prose.
%%   2. Every read and write of tasks.json is atomic.
%% Box definitions where the name alone is not enough:
%%   validate the plan file      - a script, structure only, no judgement of the
%%                                 plan's content: the file parses as JSON, its
%%                                 task number matches, its revision is a positive
%%                                 integer, and its sections are a non-empty array
%%                                 of objects each holding a unique kebab-case id,
%%                                 a string title and a string body.
%%                                 See scripts/tackle-tasks/validatePlanFile.ts
%%   validate the review structure
%%                               - a script, structure only: the review parses,
%%                                 carries one of the three verdicts, and carries
%%                                 the fields that verdict requires.
%%                                 See scripts/tackle-tasks/validateCodexReview.ts
%%   read the review verdict     - three outcomes: accept, amend, scrap. Only
%%                                 accept is drawn here.

  INPUT["Input: { active task, initialized worktree }"] --> P
  P["plan the task"] --> VALP["validate the plan file"]
  VALP --> R["codex reviews the plan"]
  R --> VALR["validate the review structure"]
  VALR --> QR["read the review verdict: accept"]
  QR --> RECEIPT["Receipt: { plan file }"]

  classDef script fill:#2f7d46,stroke:#1e5c31,color:#ffffff
  classDef prose fill:#e0b400,stroke:#a88600,color:#1a1a1a
  classDef output fill:#3b6ea5,stroke:#254a70,color:#ffffff
  class VALP,VALR,QR script
  class P,R prose
  class INPUT,RECEIPT output
