%% PLANNING PIPELINE. Split from pipeline.mmd.
%% Input: an active task and an initialized worktree from the preamble pipeline.
%% Starts at "plan the task". Ends with a plan file, or with an exit.
%% Rules that apply everywhere, not steps:
%%   1. Every git interaction goes through a script. Never prose.
%%   2. Every read and write of tasks.json is atomic.
%%   3. A script that fails operationally, as opposed to returning a verdict,
%%      exits the run as run-failed. The task is already active and a worktree
%%      already exists here, so the exit workflow always runs in full.
%%   4. Codex gets two rounds of each kind. Two scraps end the run. Two amend
%%      rounds stop the re-review: the amendments are applied and the plan is
%%      taken as it stands.
%% Box definitions where the name alone is not enough:
%%   is the plan file structure valid?      - a script, structure only, no judgement of the
%%                                 plan's content: the file parses as JSON, its
%%                                 task number matches, its revision is a positive
%%                                 integer, and its sections are a non-empty array
%%                                 of objects each holding a unique kebab-case id,
%%                                 a string title and a string body.
%%                                 See scripts/tackle-tasks/validatePlanFile.ts
%%   is the review file structure valid?
%%                               - a script, structure only: the review parses,
%%                                 carries one of the three verdicts, and carries
%%                                 the fields that verdict requires.
%%                                 See scripts/tackle-tasks/validateCodexReview.ts
%%   what is the review verdict?     - three outcomes: accept, amend, scrap.
%%   script adds the codex scrap notes to the task brief
%%                               - the replan is not a bare retry. The planner
%%                                 reads the brief, so the scrap notes have to be
%%                                 written into the brief or the second plan
%%                                 repeats the first one's mistakes.
%%   2 amend rounds done?        - the amendments are applied either way. The
%%                                 counter only decides whether codex sees the
%%                                 amended plan again.
%% A structure failure is a broken agent, not a bad plan, so it is not retried and
%% does not burn a scrap attempt. Its receipt carries the validator's problem text.
%% Exit types this pipeline can produce:
%%   plan-scrapped      - codex scrapped the plan twice
%%   run-failed         - a script failed operationally, structure failures included
%% run-failed is deliberately not drawn as an edge out of every box. It can leave
%% ANY green box, so drawing it would add one edge per box and hide the flow.

  ACTIVE_TASK_WORKTREE_INPUT["Input: { }"] --> PLAN_THE_TASK
  PLAN_THE_TASK["plan the task"] --> DID_PLANNER_RETURN_A_RESULT{"did the agent return a result?"}
  DID_PLANNER_RETURN_A_RESULT --> DID_PLANNER_RETURN_A_RESULT_YES["YES"]
  DID_PLANNER_RETURN_A_RESULT --> DID_PLANNER_RETURN_A_RESULT_NO["NO"]
  DID_PLANNER_RETURN_A_RESULT_YES --> DRAFT_PLAN_FILE_OUTPUT["Output"]
  DID_PLANNER_RETURN_A_RESULT_NO --> RETRY_PLANNER["retry the box"] --> PLAN_THE_TASK
  DRAFT_PLAN_FILE_OUTPUT --> DRAFT_PLAN_FILE_RECEIPT["Receipt: { }"]
  DRAFT_PLAN_FILE_RECEIPT --> IS_PLAN_FILE_VALID{"is the plan file structure valid?"}
  IS_PLAN_FILE_VALID --> IS_PLAN_FILE_VALID_YES["YES"]
  IS_PLAN_FILE_VALID --> IS_PLAN_FILE_VALID_NO["NO"]
  IS_PLAN_FILE_VALID_YES --> DRAFT_PLAN_FILE_OUTPUT_TRUSTED["Output"]
  DRAFT_PLAN_FILE_OUTPUT_TRUSTED --> DRAFT_PLAN_FILE_RECEIPT_TRUSTED["Receipt: { }"]
  DRAFT_PLAN_FILE_RECEIPT_TRUSTED --> CODEX_REVIEWS_PLAN["codex reviews the plan"]
  IS_PLAN_FILE_VALID_NO -- "exit type: run-failed<br/>exit note: the plan file is malformed" --> VALIDATOR_FAILURE_OUTPUT
  CODEX_REVIEWS_PLAN --> DID_PLAN_REVIEWER_RETURN_A_RESULT{"did the agent return a result?"}
  DID_PLAN_REVIEWER_RETURN_A_RESULT --> DID_PLAN_REVIEWER_RETURN_A_RESULT_YES["YES"]
  DID_PLAN_REVIEWER_RETURN_A_RESULT --> DID_PLAN_REVIEWER_RETURN_A_RESULT_NO["NO"]
  DID_PLAN_REVIEWER_RETURN_A_RESULT_YES --> CODEX_REVIEW_OUTPUT["Output"]
  DID_PLAN_REVIEWER_RETURN_A_RESULT_NO --> RETRY_PLAN_REVIEWER["retry the box"] --> CODEX_REVIEWS_PLAN
  CODEX_REVIEW_OUTPUT --> CODEX_REVIEW_RECEIPT["Receipt: { }"]
  CODEX_REVIEW_RECEIPT --> IS_REVIEW_FILE_VALID{"is the review file structure valid?"}
  IS_REVIEW_FILE_VALID --> IS_REVIEW_FILE_VALID_YES["YES"]
  IS_REVIEW_FILE_VALID --> IS_REVIEW_FILE_VALID_NO["NO"]
  IS_REVIEW_FILE_VALID_YES --> CODEX_REVIEW_OUTPUT_TRUSTED["Output"]
  CODEX_REVIEW_OUTPUT_TRUSTED --> CODEX_REVIEW_RECEIPT_TRUSTED["Receipt: { }"]
  CODEX_REVIEW_RECEIPT_TRUSTED --> WHAT_IS_REVIEW_VERDICT{"what is the review verdict?"}
  IS_REVIEW_FILE_VALID_NO -- "exit type: run-failed<br/>exit note: the codex review is malformed" --> VALIDATOR_FAILURE_OUTPUT
  WHAT_IS_REVIEW_VERDICT --> VERDICT_SCRAP["SCRAP"]
  WHAT_IS_REVIEW_VERDICT --> VERDICT_AMEND["AMEND"]
  WHAT_IS_REVIEW_VERDICT --> VERDICT_ACCEPT["ACCEPT"]

  VERDICT_SCRAP --> IS_FIRST_TIME_SCRAP{"First Time Scrap?"}
  IS_FIRST_TIME_SCRAP --> IS_FIRST_TIME_SCRAP_YES["YES"]
  IS_FIRST_TIME_SCRAP --> IS_FIRST_TIME_SCRAP_NO["NO"]
  IS_FIRST_TIME_SCRAP_YES --> ADD_SCRAP_NOTES_TO_BRIEF["script adds the codex scrap<br/>notes to the task brief"]
  ADD_SCRAP_NOTES_TO_BRIEF --> PLAN_THE_TASK
  IS_FIRST_TIME_SCRAP_NO --> PLAN_SCRAPPED_2X["Second Time Scrap"]
  PLAN_SCRAPPED_2X -- "exit type: plan-scrapped<br/>exit note: codex scrapped<br/>the plan twice" --> EXIT_WORKFLOW

  VERDICT_AMEND --> APPLY_CODEX_AMENDMENTS["Try: script applies codex<br/>amendments to the plan"]
  APPLY_CODEX_AMENDMENTS --> ARE_2_AMEND_ROUNDS_DONE{"2 amend rounds done?"}
  ARE_2_AMEND_ROUNDS_DONE --> ARE_2_AMEND_ROUNDS_DONE_YES["YES"]
  ARE_2_AMEND_ROUNDS_DONE --> ARE_2_AMEND_ROUNDS_DONE_NO["NO"]
  ARE_2_AMEND_ROUNDS_DONE_YES --> FINISHED_PLAN_OUTPUT
  ARE_2_AMEND_ROUNDS_DONE_NO -- "re-review the amended plan" --> CODEX_REVIEWS_PLAN

  VERDICT_ACCEPT --> FINISHED_PLAN_OUTPUT["Output"]
  FINISHED_PLAN_OUTPUT --> FINISHED_PLAN_RECEIPT["Receipt: { }"]
  FINISHED_PLAN_RECEIPT --> IS_FINISHED_PLAN_RECEIPT_VALID{"is the finished plan receipt structure valid?"}
  IS_FINISHED_PLAN_RECEIPT_VALID --> IS_FINISHED_PLAN_RECEIPT_VALID_YES["YES"]
  IS_FINISHED_PLAN_RECEIPT_VALID --> IS_FINISHED_PLAN_RECEIPT_VALID_NO["NO"]
  IS_FINISHED_PLAN_RECEIPT_VALID_YES --> FINISHED_PLAN_OUTPUT_TRUSTED["Output"]
  FINISHED_PLAN_OUTPUT_TRUSTED --> FINISHED_PLAN_RECEIPT_TRUSTED["Receipt: { }"]
  IS_FINISHED_PLAN_RECEIPT_VALID_NO -- "exit type: run-failed<br/>exit note: the finished plan<br/>receipt is malformed" --> VALIDATOR_FAILURE_OUTPUT

  VALIDATOR_FAILURE_OUTPUT["Output"] --> VALIDATOR_FAILURE_RECEIPT["Receipt: { }"]
  VALIDATOR_FAILURE_RECEIPT --> EXIT_WORKFLOW

  EXIT_WORKFLOW["exit workflow"] --> EXIT_OUTPUT["Output"]
  EXIT_OUTPUT --> EXIT_RECEIPT["Receipt: { }"]

  %% pass/nopass: green is the branch that keeps heading for the receipt,
  %% red is the branch that ends in the exit workflow.
  classDef script fill:#2f7d46,stroke:#1e5c31,color:#ffffff
  classDef agent fill:#e07b39,stroke:#a8541f,color:#1a1a1a
  classDef decision fill:#e0b400,stroke:#a88600,color:#1a1a1a
  classDef receipt fill:#ffffff,stroke:#333333,color:#000000
  classDef output fill:#3b6ea5,stroke:#254a70,color:#ffffff
  classDef fail fill:red,stroke:#254a70,color:#ffffff
  classDef verdict fill:#4a4a4a,stroke:#8a8a8a,color:#ffffff
  classDef pass fill:#2f7d46,stroke:#1e5c31,color:#ffffff
  classDef nopass fill:#a52a1e,stroke:#6d1a12,color:#ffffff
  class IS_PLAN_FILE_VALID,IS_REVIEW_FILE_VALID,WHAT_IS_REVIEW_VERDICT,IS_FIRST_TIME_SCRAP,ARE_2_AMEND_ROUNDS_DONE,IS_FINISHED_PLAN_RECEIPT_VALID,VERDICT_AMEND,DID_PLANNER_RETURN_A_RESULT,DID_PLAN_REVIEWER_RETURN_A_RESULT decision
  class APPLY_CODEX_AMENDMENTS,ADD_SCRAP_NOTES_TO_BRIEF,RETRY_PLANNER,RETRY_PLAN_REVIEWER script
  class PLAN_THE_TASK,CODEX_REVIEWS_PLAN agent
  class PLAN_SCRAPPED_2X verdict
  class IS_FIRST_TIME_SCRAP_YES,ARE_2_AMEND_ROUNDS_DONE_YES,ARE_2_AMEND_ROUNDS_DONE_NO,IS_PLAN_FILE_VALID_YES,IS_REVIEW_FILE_VALID_YES,IS_FINISHED_PLAN_RECEIPT_VALID_YES,VERDICT_ACCEPT,DID_PLANNER_RETURN_A_RESULT_YES,DID_PLAN_REVIEWER_RETURN_A_RESULT_YES pass
  class IS_FIRST_TIME_SCRAP_NO,IS_PLAN_FILE_VALID_NO,IS_REVIEW_FILE_VALID_NO,IS_FINISHED_PLAN_RECEIPT_VALID_NO,VERDICT_SCRAP,DID_PLANNER_RETURN_A_RESULT_NO,DID_PLAN_REVIEWER_RETURN_A_RESULT_NO nopass
  class EXIT_WORKFLOW fail
  class ACTIVE_TASK_WORKTREE_INPUT,FINISHED_PLAN_OUTPUT_TRUSTED,EXIT_OUTPUT,DRAFT_PLAN_FILE_OUTPUT,DRAFT_PLAN_FILE_OUTPUT_TRUSTED,CODEX_REVIEW_OUTPUT,CODEX_REVIEW_OUTPUT_TRUSTED,FINISHED_PLAN_OUTPUT,VALIDATOR_FAILURE_OUTPUT output
  class DRAFT_PLAN_FILE_RECEIPT,CODEX_REVIEW_RECEIPT,FINISHED_PLAN_RECEIPT,EXIT_RECEIPT,DRAFT_PLAN_FILE_RECEIPT_TRUSTED,CODEX_REVIEW_RECEIPT_TRUSTED,FINISHED_PLAN_RECEIPT_TRUSTED,VALIDATOR_FAILURE_RECEIPT receipt
