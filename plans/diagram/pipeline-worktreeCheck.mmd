%% WORKTREE CHECK. Input: an active task from the preamble pipeline.
%% ---
%% Every git interaction goes through a script, never prose.
%% ---
%% A lost mutation is reconciled by re-reading state, never retried blindly.
%% ---
%% "safe to use" is structural only; it says nothing about the work inside.
%% ---
%% "resumable" is semantic: did the previous run record where it stopped.
%% ---
%% RESUME IS WORKTREE-LEVEL: the workflow still restarts at document generation and planning.
%% ---
%% The lease is taken or adopted before any reset, per resetTaskWorktree.ts.
%% ---
%% A safe worktree is never reset, because its committed work is the user's to keep or discard.
%% ---
%% The fence question is asked only of a resumable worktree, and it is asked last.
%% ---
%% It covers committed work plus staged and unstaged edits, on every layer.
%% ---
%% Untracked files are excluded, because the generated docs are untracked by design.
%% ---
%% Every exit here takes the failures exit, because the task is already active.
%% ---
%% Exit types this pipeline can produce:
%% ---
%%   not-resumable   - a safe worktree holds work no run recorded a stopping point for
%% ---
%%   fence-violation - the resumed worktree touched files the task does not own
%% ---
%%   run-failed      - a script failed operationally

  ACTIVE_TASK_INPUT["Input: { taskNumber, worktree path }"] --> DOES_WORKTREE_EXIST
  DOES_WORKTREE_EXIST{"does a worktree exist?"} -->|YES| IS_WORKTREE_SAFE_TO_USE{"is the worktree safe to use?"}
  DOES_WORKTREE_EXIST -->|NO| CREATE_WORKTREE["create a worktree"]
  CREATE_WORKTREE --> TAKE_WORKTREE_LEASE["take the worktree lease for this run"]
  TAKE_WORKTREE_LEASE -- "docs mode: AUTOGEN" --> INIT_SUBMODULES_RECURSIVELY

  IS_WORKTREE_SAFE_TO_USE -->|YES| IS_PREVIOUS_RUN_RESUMABLE{"is the previous run's work resumable?<br/>adopt the lease for this run"}
  IS_WORKTREE_SAFE_TO_USE -->|NO| TAKE_WORKTREE_LEASE_BEFORE_RESET["take the worktree lease for this run"]
  TAKE_WORKTREE_LEASE_BEFORE_RESET --> RESET_WORKTREE

  IS_PREVIOUS_RUN_RESUMABLE -->|YES| DOES_FENCE_COVER_WORKTREE{"does the task's file list cover<br/>what the worktree touched?"}
  IS_PREVIOUS_RUN_RESUMABLE -- "NO<br/>exit type: not-resumable<br/>exit note: a safe worktree holds work<br/>no run recorded a stopping point for" --> FAILURES_EXIT

  DOES_FENCE_COVER_WORKTREE -- "YES<br/>docs mode: UPDATE" --> INIT_SUBMODULES_RECURSIVELY
  DOES_FENCE_COVER_WORKTREE -- "NO<br/>exit type: fence-violation<br/>exit note: the resumed worktree touched<br/>files the task does not own" --> FAILURES_EXIT

  RESET_WORKTREE["reset the worktree"] -- "docs mode: AUTOGEN" --> INIT_SUBMODULES_RECURSIVELY

  INIT_SUBMODULES_RECURSIVELY["init submodules recursively"] --> DOCUMENT_GENERATION_PIPELINE["document generation pipeline"]

  FAILURES_EXIT["failures exit"]

  %% pass/nopass: green reuses what is already there, red rebuilds it.
  classDef pipeline fill:#2f7d46,stroke:#1e5c31,color:#ffffff
  classDef script fill:#2f7d46,stroke:#1e5c31,color:#ffffff
  classDef decision fill:#e0b400,stroke:#a88600,color:#1a1a1a
  classDef output fill:#3b6ea5,stroke:#254a70,color:#ffffff
  classDef pass fill:#2f7d46,stroke:#1e5c31,color:#ffffff
  classDef nopass fill:#a52a1e,stroke:#6d1a12,color:#ffffff
  classDef fail fill:red,stroke:#254a70,color:#ffffff
  class DOES_WORKTREE_EXIST,IS_WORKTREE_SAFE_TO_USE,IS_PREVIOUS_RUN_RESUMABLE,DOES_FENCE_COVER_WORKTREE decision
  class CREATE_WORKTREE,RESET_WORKTREE,INIT_SUBMODULES_RECURSIVELY,TAKE_WORKTREE_LEASE,TAKE_WORKTREE_LEASE_BEFORE_RESET script
  class DOCUMENT_GENERATION_PIPELINE pipeline
  class FAILURES_EXIT fail
  class ACTIVE_TASK_INPUT output
