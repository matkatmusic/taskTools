flowchart TB
%% One agent() call. /run-step starts at WHAT_DID_THE_PLANNER_RETURN; paths end at orange box or STOP; its answer feeds named diagram.

  subgraph whatDidThePlannerReturn ["Input: [PLAN_THE_TASK]'s result"]
    direction TB
    WHAT_DID_THE_PLANNER_RETURN["what did the planner return?<br/>2 clarify rounds done?<br/>write the clarify request"]
    CODEX_REVIEWS_PLAN["CODEX_REVIEWS_THE_PLAN"]
    DOCUMENT_GENERATION["what is the docs mode?<br/>write the task brief"]
    PLAN_THE_TASK["PLAN_THE_TASK"]
    FAILURES_EXIT["did any work land? write the outcome<br/>mark inactive, release the lease and the lock<br/>report the exit type and note"]
    STOP["stop"]
    WHAT_IS_REVIEW_VERDICT["what is the review verdict?<br/>update tasks.json entry<br/>2 codex reviews done?"]
  end
  WHAT_DID_THE_PLANNER_RETURN -- "PLAN" --> CODEX_REVIEWS_PLAN
  WHAT_DID_THE_PLANNER_RETURN -- "CLARIFY<br/>docs mode: UPDATE" --> DOCUMENT_GENERATION
  DOCUMENT_GENERATION --> PLAN_THE_TASK
  FAILURES_EXIT --> STOP
  WHAT_DID_THE_PLANNER_RETURN -- "clarify-stuck" --> FAILURES_EXIT
  CODEX_REVIEWS_PLAN --> WHAT_IS_REVIEW_VERDICT
  PLAN_THE_TASK --> WHAT_DID_THE_PLANNER_RETURN

  classDef script fill:#2f7d46,stroke:#1e5c31,color:#ffffff
  classDef returns_a_prompt fill:#e07b39,stroke:#a8541f,color:#1a1a1a
  classDef fail fill:red,stroke:#254a70,color:#ffffff
  classDef output fill:#3b6ea5,stroke:#254a70,color:#ffffff
  class WHAT_DID_THE_PLANNER_RETURN,DOCUMENT_GENERATION,WHAT_IS_REVIEW_VERDICT script
  class CODEX_REVIEWS_PLAN,PLAN_THE_TASK returns_a_prompt
  class FAILURES_EXIT fail
  class STOP output
