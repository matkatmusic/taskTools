%% One agent() call. /run-step starts at WHAT_DID_THE_PLANNER_RETURN. Every path ends at an orange block or a dashed block.

  subgraph whatDidThePlannerReturn ["Input: [PLAN_THE_TASK]'s result"]
    direction TB
    WHAT_DID_THE_PLANNER_RETURN["PLANNER_RESULT"]
    ARE_2_CLARIFY_ROUNDS_DONE_Q["2 clarify rounds done?"]
    WRITE_CLARIFY_REQUEST["write the clarify request<br/>into the tasks.json entry"]
  end
  subgraph whatDidThePlannerReturnNext ["next diagram"]
    direction TB
    CODEX_REVIEWS_PLAN["CODEX_REVIEWS_PLAN"]
    DOCUMENT_GENERATION["write the task brief"]
    FAILURES_EXIT["FAILURES_EXIT"]
  end
  whatDidThePlannerReturn ~~~ whatDidThePlannerReturnNext

  WHAT_DID_THE_PLANNER_RETURN -- "PLAN" --> CODEX_REVIEWS_PLAN
  WHAT_DID_THE_PLANNER_RETURN -- "CLARIFY" --> ARE_2_CLARIFY_ROUNDS_DONE_Q
  ARE_2_CLARIFY_ROUNDS_DONE_Q -- "NO" --> WRITE_CLARIFY_REQUEST
  ARE_2_CLARIFY_ROUNDS_DONE_Q -- "YES<br/>clarify-stuck" --> FAILURES_EXIT
  WRITE_CLARIFY_REQUEST -- "docs mode: UPDATE" --> DOCUMENT_GENERATION

  classDef script fill:#2f7d46,stroke:#1e5c31,color:#ffffff
