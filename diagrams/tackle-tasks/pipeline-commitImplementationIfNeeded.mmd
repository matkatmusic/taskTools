  commitImplementationIfNeeded ~~~ commitImplementationIfNeededNext

  COMMIT_IMPLEMENTATION_IF_NEEDED --> ARE_TASK_TESTS_SKIPPED_Q
  COMMIT_IMPLEMENTATION_IF_NEEDED -- "NO<br/>implementation incomplete" --> FAILURES_EXIT
  COMMIT_TEST_FIX_IF_NEEDED --> ARE_TASK_TESTS_SKIPPED_Q
  ARE_TASK_TESTS_SKIPPED_Q -- "YES<br/>no task tests, no codex test review" --> LOCK_SOURCE_REPO
  ARE_TASK_TESTS_SKIPPED_Q -- "NO" --> RUN_TASK_TESTS
  RUN_TASK_TESTS --> DO_TASK_TESTS_PASS_Q
  DO_TASK_TESTS_PASS_Q -- "YES" --> CODEX_REVIEWS_TESTS
  DO_TASK_TESTS_PASS_Q -- "YES<br/>difficulty 3 or less" --> LOCK_SOURCE_REPO
  DO_TASK_TESTS_PASS_Q -- "NO" --> ARE_2_TEST_FIXES_DONE_Q
  ARE_2_TEST_FIXES_DONE_Q -- "NO" --> AMEND_ENTRY_WITH_FAILING_TESTS
  ARE_2_TEST_FIXES_DONE_Q -- "YES<br/>tests-red" --> FAILURES_EXIT
  AMEND_ENTRY_WITH_FAILING_TESTS -- "pass the failing tests to the agent" --> FIX_IMPLEMENT_TASK_TESTS

