  runFullSuite ~~~ runFullSuiteNext

  COMMIT_SUITE_FIX_IF_NEEDED --> RUN_FULL_SUITE
  RUN_FULL_SUITE --> DO_ALL_TESTS_PASS_Q
  DO_ALL_TESTS_PASS_Q -- "NO" --> ARE_2_SUITE_FIXES_DONE_Q
  ARE_2_SUITE_FIXES_DONE_Q -- "NO<br/>pass the failing tests to the agent" --> FIX_THE_CODEBASE_FOR_SUITE
  ARE_2_SUITE_FIXES_DONE_Q -- "YES<br/>suite-red" --> FAILURES_EXIT
  DO_ALL_TESTS_PASS_Q -- "YES" --> DID_CHANGES_STAY_INSIDE_FENCE_Q
  DID_CHANGES_STAY_INSIDE_FENCE_Q -- "NO<br/>fence-violation" --> FAILURES_EXIT
  DID_CHANGES_STAY_INSIDE_FENCE_Q -- "YES" --> MERGE_WORKTREES
  MERGE_WORKTREES --> READ_MERGE_PUBLICATION_STATE
  READ_MERGE_PUBLICATION_STATE --> WHAT_IS_PUBLICATION_STATE_Q
  WHAT_IS_PUBLICATION_STATE_Q -- "ALL LANDED" --> MERGE_SUCCEEDED_EXIT
  WHAT_IS_PUBLICATION_STATE_Q -- "SOME LANDED<br/>partially-published" --> FAILURES_EXIT
  WHAT_IS_PUBLICATION_STATE_Q -- "NONE LANDED" --> ARE_2_MERGE_ATTEMPTS_DONE_Q
  ARE_2_MERGE_ATTEMPTS_DONE_Q -- "NO<br/>the target branch tip moved" --> REBASE_ONTO_TARGET_BRANCH
  ARE_2_MERGE_ATTEMPTS_DONE_Q -- "YES<br/>merge-failed" --> FAILURES_EXIT

