%% The pipeline as scripts/tackle-tasks/monolith-pipeline.ts runs it: 18 block names, drawn fully unrolled.
%% ---
%% Each large box is one agent() call. Its first block is where /run-step starts. Every path inside it runs to an orange box or to STOP. No arrow points back.
%% ---
%% An orange box returns a prompt. runStep() walks into it, hands the agent its prompt, and stops. The agent answers it.
%% ---
%% The agent's answer is the input of the next large box: the one whose title says 'after <that orange box> answers'.
%% ---
%% The same block name appears in several large boxes; the ID prefix E<n>_ only keeps mermaid happy. The NONE LANDED retry is drawn once, since merge tries stop at 2.

  subgraph entry1 ["Start of workflow"]
    direction TB
    E1_PREAMBLE_STATUS_CHECK["task status<br/>worktree status<br/>init submodules recursively"]
    E1_REPORT_ONLY_EXIT["report the exit type and note"]
    E1_STOP["stop"]
    E1_FAILURES_EXIT["did any work land? write the outcome<br/>mark inactive, release the lease and the lock<br/>report the exit type and note"]
    E1_DOCUMENT_GENERATION["what is the docs mode?<br/>write the task brief"]
    E1_PLAN_THE_TASK["PLAN_THE_TASK"]
  end
  E1_PREAMBLE_STATUS_CHECK -- "invalid-number<br/>blocked<br/>already-active" --> E1_REPORT_ONLY_EXIT
  E1_REPORT_ONLY_EXIT --> E1_STOP
  E1_FAILURES_EXIT --> E1_STOP
  E1_PREAMBLE_STATUS_CHECK -- "not-resumable<br/>fence-violation" --> E1_FAILURES_EXIT
  E1_PREAMBLE_STATUS_CHECK -- "docs mode: AUTOGEN or UPDATE" --> E1_DOCUMENT_GENERATION
  E1_DOCUMENT_GENERATION --> E1_PLAN_THE_TASK

  subgraph entry2 ["Input: [PLAN_THE_TASK]'s result"]
    direction TB
    E2_WHAT_DID_THE_PLANNER_RETURN["what did the planner return?<br/>2 clarify rounds done?<br/>write the clarify request"]
    E2_CODEX_REVIEWS_PLAN["CODEX_REVIEWS_THE_PLAN"]
    E2_IMPLEMENT_TASK["IMPLEMENT_TASK"]
    E2_DOCUMENT_GENERATION["what is the docs mode?<br/>write the task brief"]
    E2_PLAN_THE_TASK["PLAN_THE_TASK"]
    E2_FAILURES_EXIT["did any work land? write the outcome<br/>mark inactive, release the lease and the lock<br/>report the exit type and note"]
    E2_STOP["stop"]
  end
  E2_WHAT_DID_THE_PLANNER_RETURN -- "PLAN" --> E2_CODEX_REVIEWS_PLAN
  E2_WHAT_DID_THE_PLANNER_RETURN -- "PLAN<br/>difficulty 2 or less" --> E2_IMPLEMENT_TASK
  E2_WHAT_DID_THE_PLANNER_RETURN -- "CLARIFY<br/>docs mode: UPDATE" --> E2_DOCUMENT_GENERATION
  E2_DOCUMENT_GENERATION --> E2_PLAN_THE_TASK
  E2_FAILURES_EXIT --> E2_STOP
  E2_WHAT_DID_THE_PLANNER_RETURN -- "clarify-stuck" --> E2_FAILURES_EXIT

  subgraph entry3 ["Input: [CODEX_REVIEWS_PLAN]'s result"]
    direction TB
    E3_WHAT_IS_REVIEW_VERDICT["what is the review verdict?<br/>update tasks.json entry<br/>2 codex reviews done?"]
    E3_IMPLEMENT_TASK["IMPLEMENT_TASK"]
    E3_PLAN_THE_TASK["PLAN_THE_TASK"]
    E3_FAILURES_EXIT["did any work land? write the outcome<br/>mark inactive, release the lease and the lock<br/>report the exit type and note"]
    E3_STOP["stop"]
  end
  E3_WHAT_IS_REVIEW_VERDICT -- "ACCEPT<br/>AMEND_THEN_ACCEPT" --> E3_IMPLEMENT_TASK
  E3_WHAT_IS_REVIEW_VERDICT -- "AMEND or SCRAP<br/>replan with codex's notes" --> E3_PLAN_THE_TASK
  E3_FAILURES_EXIT --> E3_STOP
  E3_WHAT_IS_REVIEW_VERDICT -- "run-failed<br/>plan-scrapped" --> E3_FAILURES_EXIT

  subgraph entry4 ["Input: [IMPLEMENT_TASK]'s result"]
    direction TB
    E4_COMMIT_IMPLEMENTATION_IF_NEEDED["commit if needed<br/>are the task tests skipped?<br/>run task tests<br/>do the task tests pass?<br/>2 fixes done?<br/>amend entry with the failing tests"]
