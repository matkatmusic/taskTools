flowchart TB
%% One agent() call. /run-step starts at PREAMBLE_STATUS_CHECK. Every path ends at an orange block, a dashed block, or STOP.

  subgraph preambleStatusCheck ["Start of workflow"]
    direction TB
    PREAMBLE_STATUS_CHECK["is the task number valid?"]
    IS_TASK_BLOCKED_Q["is the task blocked?"]
    IS_TASK_ACTIVE_Q["is the task active?"]
    PREFLIGHT_OK_Q["is the environment ok to run in?"]
    MARK_TASK_ACTIVE["mark the task active in tasks.json"]
    DOES_WORKTREE_EXIST_Q["does a worktree exist?"]
    CREATE_WORKTREE["create a worktree"]
    TAKE_WORKTREE_LEASE["take the worktree lease for this run"]
    IS_WORKTREE_SAFE_TO_USE_Q["is the worktree safe to use?"]
    TAKE_WORKTREE_LEASE_BEFORE_RESET["take the worktree lease for this run"]
    RESET_WORKTREE["reset the worktree"]
    IS_PREVIOUS_RUN_RESUMABLE_Q["is the previous run's work resumable?<br/>adopt the lease for this run"]
    REBASE_RESUMED_WORKTREE_ONTO_STAGING["rebase the worktree onto staging<br/>when staging has moved"]
    DOES_FENCE_COVER_WORKTREE_Q["does the task's file list cover<br/>what the worktree touched?"]
    INIT_SUBMODULES_RECURSIVELY["init submodules recursively"]
    DOCUMENT_GENERATION["write the task brief"]
  end
  subgraph preambleStatusCheckNext ["next diagram"]
    direction TB
    IS_DIFFICULTY_7_PLUS_Q["IS_DIFFICULTY_7_PLUS_Q"]
    REPORT_ONLY_EXIT["REPORT_ONLY_EXIT"]
    FAILURES_EXIT["FAILURES_EXIT"]
  end
  preambleStatusCheck ~~~ preambleStatusCheckNext

  PREAMBLE_STATUS_CHECK -- "NO<br/>invalid-number" --> REPORT_ONLY_EXIT
  PREAMBLE_STATUS_CHECK -- "YES" --> IS_TASK_BLOCKED_Q
  IS_TASK_BLOCKED_Q -- "YES<br/>blocked" --> REPORT_ONLY_EXIT
  IS_TASK_BLOCKED_Q -- "NO" --> IS_TASK_ACTIVE_Q
  IS_TASK_ACTIVE_Q -- "YES<br/>already-active" --> REPORT_ONLY_EXIT
  IS_TASK_ACTIVE_Q -- "NO" --> PREFLIGHT_OK_Q
  PREFLIGHT_OK_Q -- "NO<br/>preflight-failed" --> REPORT_ONLY_EXIT
  PREFLIGHT_OK_Q -- "YES" --> MARK_TASK_ACTIVE
  MARK_TASK_ACTIVE --> DOES_WORKTREE_EXIST_Q
  DOES_WORKTREE_EXIST_Q -- "NO" --> CREATE_WORKTREE
  CREATE_WORKTREE --> TAKE_WORKTREE_LEASE
  TAKE_WORKTREE_LEASE -- "docs mode: AUTOGEN" --> INIT_SUBMODULES_RECURSIVELY
  DOES_WORKTREE_EXIST_Q -- "YES" --> IS_WORKTREE_SAFE_TO_USE_Q
  IS_WORKTREE_SAFE_TO_USE_Q -- "NO" --> TAKE_WORKTREE_LEASE_BEFORE_RESET
  TAKE_WORKTREE_LEASE_BEFORE_RESET --> RESET_WORKTREE
  RESET_WORKTREE -- "docs mode: AUTOGEN" --> INIT_SUBMODULES_RECURSIVELY
  IS_WORKTREE_SAFE_TO_USE_Q -- "YES" --> IS_PREVIOUS_RUN_RESUMABLE_Q
  IS_PREVIOUS_RUN_RESUMABLE_Q -- "NO<br/>not-resumable" --> FAILURES_EXIT
  IS_PREVIOUS_RUN_RESUMABLE_Q -- "YES" --> REBASE_RESUMED_WORKTREE_ONTO_STAGING
  REBASE_RESUMED_WORKTREE_ONTO_STAGING -- "staging already an ancestor,<br/>or rebased clean" --> DOES_FENCE_COVER_WORKTREE_Q
  REBASE_RESUMED_WORKTREE_ONTO_STAGING -- "conflicts<br/>returnTo: DOES_FENCE_COVER_WORKTREE_Q" --> ARE_2_CONFLICT_FIXES_DONE_Q
  DOES_FENCE_COVER_WORKTREE_Q -- "NO<br/>fence-violation" --> FAILURES_EXIT
  DOES_FENCE_COVER_WORKTREE_Q -- "YES<br/>docs mode: UPDATE" --> INIT_SUBMODULES_RECURSIVELY
  INIT_SUBMODULES_RECURSIVELY -- "NO<br/>owned-file-missing" --> FAILURES_EXIT
  INIT_SUBMODULES_RECURSIVELY --> DOCUMENT_GENERATION
  DOCUMENT_GENERATION --> IS_DIFFICULTY_7_PLUS_Q

  classDef script fill:#2f7d46,stroke:#1e5c31,color:#ffffff
  classDef returns_a_prompt fill:#e07b39,stroke:#a8541f,color:#1a1a1a
  classDef fail fill:red,stroke:#254a70,color:#ffffff
  classDef output fill:#3b6ea5,stroke:#254a70,color:#ffffff
  classDef next_diagram fill:#ffffff,stroke:#3b6ea5,stroke-width:2px,stroke-dasharray:6 4,color:#1a1a1a
  class PREAMBLE_STATUS_CHECK,IS_TASK_BLOCKED_Q,IS_TASK_ACTIVE_Q,PREFLIGHT_OK_Q,MARK_TASK_ACTIVE,DOES_WORKTREE_EXIST_Q,CREATE_WORKTREE,TAKE_WORKTREE_LEASE,IS_WORKTREE_SAFE_TO_USE_Q,TAKE_WORKTREE_LEASE_BEFORE_RESET,RESET_WORKTREE,IS_PREVIOUS_RUN_RESUMABLE_Q,REBASE_RESUMED_WORKTREE_ONTO_STAGING,DOES_FENCE_COVER_WORKTREE_Q,INIT_SUBMODULES_RECURSIVELY,DOCUMENT_GENERATION script
  class IS_DIFFICULTY_7_PLUS_Q,REPORT_ONLY_EXIT,FAILURES_EXIT,ARE_2_CONFLICT_FIXES_DONE_Q next_diagram
