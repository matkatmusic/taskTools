{
  "type": "module",
  "scripts": {
    "steps": "node --no-inspect scripts/generateSteps.ts && node --no-inspect scripts/generateWorkflow.ts",
    "workflow": "node --no-inspect scripts/generateWorkflow.ts",
    "steps:watch": "node --no-inspect scripts/generateSteps.ts --watch",
    "test": "node --test \"tests/**/*.test.ts\" \"scripts/tackle-tasks/**/*.test.ts\"",
    "test:baseline": "node --no-inspect scripts/checkTestBaseline.ts"
  },
  "devDependencies": {
    "@types/node": "^26.2.0"
  }
}
