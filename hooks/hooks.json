{
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/scripts/hooks/viewTaskHook.ts\""
          },
          {
            "type": "command",
            "command": "node --no-inspect \"${CLAUDE_PLUGIN_ROOT}/scripts/hooks/readFileHook.ts\""
          },
          {
            "type": "command",
            "command": "node --no-inspect \"${CLAUDE_PLUGIN_ROOT}/scripts/hooks/runStepHook.ts\"",
            "timeout": 1200
          },
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/scripts/hooks/taskStatsHook.ts\""
          },
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/scripts/hooks/taskTestsHook.ts\"",
            "timeout": 600
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Edit|Write|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node --no-inspect \"${CLAUDE_PLUGIN_ROOT}/scripts/hooks/turn-modified-flag.ts\" --snapshot 2>/dev/null || true"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node --no-inspect \"${CLAUDE_PLUGIN_ROOT}/scripts/hooks/turn-modified-flag.ts\" 2>/dev/null || true"
          },
          {
            "type": "command",
            "command": "node --no-inspect \"${CLAUDE_PLUGIN_ROOT}/scripts/hooks/reflow-comments-post.ts\"",
            "statusMessage": "Reflowing wrapped comments..."
          }
        ]
      },
      {
        "matcher": "Skill",
        "hooks": [
          {
            "type": "command",
            "command": "node --no-inspect \"${CLAUDE_PLUGIN_ROOT}/scripts/hooks/readFileHook.ts\""
          },
          {
            "type": "command",
            "command": "node --no-inspect \"${CLAUDE_PLUGIN_ROOT}/scripts/hooks/runStepHook.ts\"",
            "timeout": 1200
          },
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/scripts/hooks/taskTestsHook.ts\"",
            "timeout": 600
          }
        ]
      },
      {
        "matcher": "Workflow",
        "hooks": [
          {
            "type": "command",
            "command": "node --no-inspect \"${CLAUDE_PLUGIN_ROOT}/scripts/hooks/workflowLivenessHook.ts\""
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node --no-inspect \"${CLAUDE_PLUGIN_ROOT}/scripts/hooks/stage-and-summarize-stop.ts\"",
            "statusMessage": "Checking comments and unstaged work..."
          },
          {
            "type": "command",
            "command": "node --no-inspect \"${CLAUDE_PLUGIN_ROOT}/scripts/hooks/relatedTests.ts\"",
            "statusMessage": "Running related tests and tsc...",
            "timeout": 600
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node --no-inspect \"${CLAUDE_PLUGIN_ROOT}/scripts/hooks/stage-and-summarize-stop.ts\"",
            "statusMessage": "Checking comments and unstaged work..."
          },
          {
            "type": "command",
            "command": "node --no-inspect \"${CLAUDE_PLUGIN_ROOT}/scripts/hooks/runStepStopHook.ts\"",
            "statusMessage": "Checking the run-step packet..."
          },
          {
            "type": "command",
            "command": "node --no-inspect \"${CLAUDE_PLUGIN_ROOT}/scripts/hooks/relatedTests.ts\"",
            "statusMessage": "Running related tests and tsc...",
            "timeout": 600
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node --no-inspect \"${CLAUDE_PLUGIN_ROOT}/scripts/hooks/session-end-cleanup.ts\" 2>/dev/null || true"
          }
        ]
      }
    ]
  }
}
